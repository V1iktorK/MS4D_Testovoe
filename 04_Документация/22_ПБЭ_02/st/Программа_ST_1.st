(* ============================================================================
   ПБЭ № 2. Универсальный ПБЭ парной вытяжной установки - Schneider M172,
   корпус 3. Программа: Программа_ST_1

   Один экземпляр - одна парная система с основным и резервным вентиляторами.
   Экземпляры: ШУ-В5/В5", ШУ-В11/В11", ШУ-В16/В16", ШУ-В27/В27",
               ШУ-В36/В36", ШУ-В38/В38".

   Реализуется (ТЗ, приложение 1, часть 2):
     - отображение состояний и аварий;
     - МОТОЧАСЫ вентиляторов;
     - настройки выбора основного вентилятора, ПЕРЕКЛЮЧЕНИЯ и РОТАЦИИ;
     - команды и обратная связь;
     - отображение остальных узлов, в том числе заслонки при её наличии.

   Аварии поступают ОТДЕЛЬНЫМИ логическими признаками,
   разбор битовых масок НЕ ТРЕБУЕТСЯ (ТЗ, п. 3).
   Планировщик и кнопка "РАСПИСАНИЕ" ОТСУТСТВУЮТ (ТЗ, п. 3.1).
   ============================================================================ *)

VAR
    v : INT;        (* признак наличия аварии *)
    r1 : BOOL;      (* снимок обратной связи вентилятора 1 в начале цикла *)
    r2 : BOOL;      (* снимок обратной связи вентилятора 2 в начале цикла *)
END_VAR

(* Снимки обратной связи ДО всех пересчётов. Нужны для корректного подсчёта
   пусков по фронту и для определения смены основного вентилятора. *)
r1 := РаботаВент1.Value;
r2 := РаботаВент2.Value;

(* ===========================================================================
   1. ОГРАНИЧЕНИЕ ВВОДИМЫХ УСТАВОК
   =========================================================================== *)

ЗадТВытяжки.Value := LIMIT(MN := 5.0, IN := ЗадТВытяжки.Value, MX := 40.0);

IF ЗадVВытяжки.Value < 0 THEN
    ЗадVВытяжки.Value := 0;
ELSIF ЗадVВытяжки.Value > 100 THEN
    ЗадVВытяжки.Value := 100;
END_IF;

IF ПериодПереключенияВент.Value < 1 THEN
    ПериодПереключенияВент.Value := 1;
ELSIF ПериодПереключенияВент.Value > 10000 THEN
    ПериодПереключенияВент.Value := 10000;
END_IF;

(* 1 - вентилятор 1, 2 - вентилятор 2, 3 - автоматическая ротация *)
IF ВыборОсновногоВент.Value < 1 THEN
    ВыборОсновногоВент.Value := 1;
ELSIF ВыборОсновногоВент.Value > 3 THEN
    ВыборОсновногоВент.Value := 1;
END_IF;

IF МчВент1Порог.Value < 1 THEN
    МчВент1Порог.Value := 1;
END_IF;

IF МчВент2Порог.Value < 1 THEN
    МчВент2Порог.Value := 1;
END_IF;

(* ===========================================================================
   2. ВТОРОЙ ВЕНТИЛЯТОР ОТКЛЮЧЁН НАСТРОЙКОЙ
      ТЗ, п. 1.3: неприменимые функции отключаются настройками экземпляра,
      команды по отключённым функциям не формируются.
      При одном вентиляторе ротация недоступна, роль основного - вентилятор 1.
   =========================================================================== *)

IF NOT НастрЕстьВторойВент.Value THEN
    ПускВент2.Value          := FALSE;
    СтопВент2.Value          := TRUE;
    РотацияВключена.Value    := FALSE;
    ВыборОсновногоВент.Value := 1;
    РучноеПереключение.Value := FALSE;
END_IF;

(* Зеркальный признак останова *)
Отключена.Value := NOT Включена.Value;

(* Взаимоисключение по одному узлу: приоритет у "Стоп" *)
IF ПускВент1.Value AND СтопВент1.Value THEN
    ПускВент1.Value := FALSE;
END_IF;

IF ПускВент2.Value AND СтопВент2.Value THEN
    ПускВент2.Value := FALSE;
END_IF;

(* ===========================================================================
   3. МОТОЧАСЫ ВЕНТИЛЯТОРОВ
      Наработка накапливается, пока вентилятор работает. Дробная часть
      хранится отдельно (REAL), целая - в параметре INT, чтобы не терять
      точность при малом шаге.

      ОГРАНИЧЕНИЕ: длительность цикла принимается равной параметру настройки
      ШагПрограммыСек (по умолчанию 1.0 с). Штатного способа получить
      фактическое время предыдущего вызова в проверенном перечне функций нет,
      поэтому величина вынесена в параметр и уточняется без правки кода.
   =========================================================================== *)

IF r1 AND НастрСчитатьМоточасы.Value THEN
    МчВент1Дроб.Value := МчВент1Дроб.Value + ШагПрограммыСек.Value / 3600.0;
    IF МчВент1Дроб.Value >= 1.0 THEN
        МчВент1.Value     := МчВент1.Value + 1;
        МчВент1Дроб.Value := МчВент1Дроб.Value - 1.0;
    END_IF;
END_IF;

IF r2 AND НастрЕстьВторойВент.Value AND НастрСчитатьМоточасы.Value THEN
    МчВент2Дроб.Value := МчВент2Дроб.Value + ШагПрограммыСек.Value / 3600.0;
    IF МчВент2Дроб.Value >= 1.0 THEN
        МчВент2.Value     := МчВент2.Value + 1;
        МчВент2Дроб.Value := МчВент2Дроб.Value - 1.0;
    END_IF;
END_IF;

(* Счётчики пусков - по фронту появления обратной связи "работает".
   Предыдущее состояние хранится в параметрах РаботаВент1Пред/Вент2Пред.
   Считаются всегда, независимо от способа получения моточасов. *)
IF r1 AND NOT РаботаВент1Пред.Value THEN
    КолПереключенийВент1.Value := КолПереключенийВент1.Value + 1;
END_IF;

IF r2 AND NOT РаботаВент2Пред.Value THEN
    КолПереключенийВент2.Value := КолПереключенийВент2.Value + 1;
END_IF;

РаботаВент1Пред.Value := r1;
РаботаВент2Пред.Value := r2;

(* Диагностика наработки *)
МчВент1Обслуживание.Value := МчВент1.Value >= МчВент1Порог.Value;
МчВент2Обслуживание.Value := МчВент2.Value >= МчВент2Порог.Value;

(* Сервисный сброс наработки *)
IF СбросМоточасов.Value THEN
    МчВент1.Value              := 0;
    МчВент1Дроб.Value          := 0.0;
    МчВент2.Value              := 0;
    МчВент2Дроб.Value          := 0.0;
    КолПереключенийВент1.Value := 0;
    КолПереключенийВент2.Value := 0;
    СбросМоточасов.Value       := FALSE;
END_IF;

(* ===========================================================================
   4. ВЫБОР ОСНОВНОГО ВЕНТИЛЯТОРА, ПЕРЕКЛЮЧЕНИЕ И РОТАЦИЯ
   =========================================================================== *)

(* Начальное назначение ролей *)
IF ОсновнойВент.Value <> 1 AND ОсновнойВент.Value <> 2 THEN
    ОсновнойВент.Value := 1;
END_IF;

(* Жёсткий выбор оператором - ротация заблокирована *)
IF ВыборОсновногоВент.Value = 1 THEN
    IF ОсновнойВент.Value <> 1 THEN
        ОсновнойВент.Value             := 1;
        ПереключениеВыполнено.Value    := TRUE;
    END_IF;
    ПереключениеРазрешено.Value := FALSE;
ELSIF ВыборОсновногоВент.Value = 2 THEN
    IF ОсновнойВент.Value <> 2 THEN
        ОсновнойВент.Value             := 2;
        ПереключениеВыполнено.Value    := TRUE;
    END_IF;
    ПереключениеРазрешено.Value := FALSE;
ELSE
    (* ВыборОсновногоВент = 3 - автоматическая ротация *)
    ПереключениеРазрешено.Value := РотацияВключена.Value AND НастрЕстьВторойВент.Value;
END_IF;

РезервныйВент.Value := 3 - ОсновнойВент.Value;

(* Наработка текущего основного и текущего резервного *)
IF ОсновнойВент.Value = 1 THEN
    НаработкаОсновного.Value  := МчВент1.Value;
    НаработкаРезервного.Value := МчВент2.Value;
ELSE
    НаработкаОсновного.Value  := МчВент2.Value;
    НаработкаРезервного.Value := МчВент1.Value;
END_IF;

(* Переключение выполняется в начале цикла, поэтому признак обнуляем здесь.
   Итоговое значение формируется ниже, по факту смены ролей в этом цикле. *)
ПереключениеВыполнено.Value := FALSE;

(* Автоматическая ротация: наработка основного достигла периода *)
IF ПереключениеРазрешено.Value AND NOT РучноеПереключение.Value THEN
    IF НаработкаОсновного.Value >= ПериодПереключенияВент.Value THEN
        ОсновнойВент.Value             := 3 - ОсновнойВент.Value;
        ПереключениеВыполнено.Value    := TRUE;
    END_IF;
END_IF;

(* Ручное переключение оператором из окна "Настройки (уставки)" *)
IF РучноеПереключение.Value AND НастрЕстьВторойВент.Value THEN
    ОсновнойВент.Value             := 3 - ОсновнойВент.Value;
    ПереключениеВыполнено.Value    := TRUE;
    РучноеПереключение.Value       := FALSE;
END_IF;

(* Пересчёт производных от ролей *)
РезервныйВент.Value := 3 - ОсновнойВент.Value;

IF ОсновнойВент.Value = 1 THEN
    НаработкаОсновного.Value  := МчВент1.Value;
    НаработкаРезервного.Value := МчВент2.Value;
ELSE
    НаработкаОсновного.Value  := МчВент2.Value;
    НаработкаРезервного.Value := МчВент1.Value;
END_IF;

(* Текст состояния ротации *)
IF NOT НастрЕстьВторойВент.Value THEN
    РотацияТекст.Value := "Один вентилятор";
ELSIF NOT РотацияВключена.Value THEN
    РотацияТекст.Value := "Ротация выключена";
ELSIF ОсновнойВент.Value = 1 THEN
    РотацияТекст.Value := "Основной В1, резервный В2";
ELSE
    РотацияТекст.Value := "Основной В2, резервный В1";
END_IF;

(* ===========================================================================
   5. КОМАНДЫ И ОБРАТНАЯ СВЯЗЬ
      Работает основной вентилятор. Резервный вводится программно только при
      аварии основного - простое резервирование уровня экземпляра.
   =========================================================================== *)

IF Включена.Value AND NOT Блокировка.Value AND NOT ДиагНетСвязи.Value THEN

    (* Авария основного вентилятора - вводим резервный *)
    IF НастрЕстьВторойВент.Value THEN
        IF ОсновнойВент.Value = 1 AND (АвВент1.Value OR АвПерепадВент1.Value) THEN
            ПускВент2.Value := TRUE;
            СтопВент1.Value := TRUE;
        ELSIF ОсновнойВент.Value = 2 AND (АвВент2.Value OR АвПерепадВент2.Value) THEN
            ПускВент1.Value := TRUE;
            СтопВент2.Value := TRUE;
        END_IF;
    END_IF;

    (* Основной - команда пуска, резервный - команда останова.
       Признак "Стоп" сбрасываем, чтобы команда пуска прошла. *)
    IF ОсновнойВент.Value = 1 THEN
        ПускВент1.Value := TRUE;
        СтопВент1.Value := FALSE;
        IF NOT НастрЕстьВторойВент.Value THEN
            ПускВент2.Value := FALSE;
            СтопВент2.Value := TRUE;
        END_IF;
    ELSE
        ПускВент2.Value := TRUE;
        СтопВент2.Value := FALSE;
        ПускВент1.Value := FALSE;
        СтопВент1.Value := TRUE;
    END_IF;

ELSE
    (* Система остановлена, заблокирована или нет связи - обе команды останова *)
    ПускВент1.Value := FALSE;
    ПускВент2.Value := FALSE;
    СтопВент1.Value := TRUE;
    IF НастрЕстьВторойВент.Value THEN
        СтопВент2.Value := TRUE;
    END_IF;
END_IF;

(* Сброс команды сброса аварий после отработки *)
IF СбросАварии.Value THEN
    СбросАварии.Value := FALSE;
END_IF;

РаботаСистемы.Value := r1 OR r2;

(* ===========================================================================
   6. СОСТОЯНИЕ ЗАСЛОНКИ (только при её наличии)
   =========================================================================== *)

IF NOT НастрЕстьЗаслонка.Value THEN
    ЗаслонкаТекст.Value := "Нет данных";
ELSIF ЗаслонкаОткрыта.Value THEN
    ЗаслонкаТекст.Value := "Открыта";
ELSIF ЗаслонкаЗакрыта.Value THEN
    ЗаслонкаТекст.Value := "Закрыта";
ELSE
    ЗаслонкаТекст.Value := "Нет данных";
END_IF;

(* ===========================================================================
   7. РАСХОД ВЫТЯЖКИ
   =========================================================================== *)

IF ОсновнойВент.Value = 1 THEN
    РасходВытяжки.Value := VФактВент1.Value * НомРасходаВытяжки.Value / 100.0;
ELSE
    РасходВытяжки.Value := VФактВент2.Value * НомРасходаВытяжки.Value / 100.0;
END_IF;

(* ===========================================================================
   8. АВАРИИ И ПРЕДУПРЕЖДЕНИЯ
      Аварии приходят ОТДЕЛЬНЫМИ BOOL - разбор битовых масок не выполняется
      (ТЗ, п. 3). Коды равны -1 при отсутствии (по образцу, рис. А.2).
      Аварии отключённых настройкой узлов не учитываются.
   =========================================================================== *)

v := 0;

IF АвПожар.Value THEN v := 1; END_IF;
IF АвОбщая.Value THEN v := 1; END_IF;

(* Вентилятор 1 действует всегда *)
IF АвВент1.Value        THEN v := 1; END_IF;
IF АвПерепадВент1.Value THEN v := 1; END_IF;

(* Признаки, зависящие от состава оборудования *)
IF НастрЕстьВторойВент.Value    AND АвВент2.Value        THEN v := 1; END_IF;
IF НастрЕстьВторойВент.Value    AND АвПерепадВент2.Value THEN v := 1; END_IF;
IF НастрЕстьЗаслонка.Value      AND АвЗаслонка.Value     THEN v := 1; END_IF;
IF НастрЕстьПерепадФильтр.Value AND АвФильтр.Value       THEN v := 1; END_IF;

ЕстьАвария.Value  := (v > 0) AND NOT ДиагНетСвязи.Value;
ОбщаяАвария.Value := ЕстьАвария.Value;
Авария.Value      := ЕстьАвария.Value;

IF ЕстьАвария.Value THEN
    КодАварии.Value := 1;
ELSE
    КодАварии.Value := -1;
END_IF;

(* Предупреждения *)
ЕстьПредупр.Value := (Блокировка.Value
                      OR Предупреждение.Value
                      OR МчВент1Обслуживание.Value
                      OR (НастрЕстьВторойВент.Value AND МчВент2Обслуживание.Value))
                     AND NOT ДиагНетСвязи.Value;

IF ЕстьПредупр.Value THEN
    КодПредупр.Value := 1;
ELSE
    КодПредупр.Value := -1;
END_IF;

(* ===========================================================================
   9. СОСТОЯНИЕ СИСТЕМЫ
      Приоритет: Авария > Нет связи > Предупреждение > Работа > Стоп
   =========================================================================== *)

IF ЕстьАвария.Value THEN
    СостояниеУст.Value := 3;
ELSIF ДиагНетСвязи.Value THEN
    СостояниеУст.Value := 4;
ELSIF ЕстьПредупр.Value THEN
    СостояниеУст.Value := 2;
ELSIF Включена.Value AND РаботаСистемы.Value THEN
    СостояниеУст.Value := 1;
ELSE
    СостояниеУст.Value := 0;
END_IF;

CASE СостояниеУст.Value OF
    0: СостояниеУстТекст.Value := "Стоп";
    1: СостояниеУстТекст.Value := "Работа";
    2: СостояниеУстТекст.Value := "Предупреждение";
    3: СостояниеУстТекст.Value := "Авария";
    4: СостояниеУстТекст.Value := "Нет данных";
ELSE
    СостояниеУстТекст.Value := "Нет данных";
END_CASE;

CASE ЗадРежима.Value OF
    0: ТекущийРежим.Value := "Авто";
    1: ТекущийРежим.Value := "Ручной";
    2: ТекущийРежим.Value := "Стоп";
ELSE
    ТекущийРежим.Value := "Нет данных";
END_CASE;

IF ДиагНетСвязи.Value THEN
    СостояниеСистемы.Value := "Нет данных";
ELSIF ЕстьАвария.Value THEN
    СостояниеСистемы.Value := "Авария";
ELSIF СостояниеУст.Value = 1 THEN
    СостояниеСистемы.Value := "Работа";
ELSE
    СостояниеСистемы.Value := "Остановлена";
END_IF;

(* Конец программы ПБЭ № 2 *)
