(* ============================================================================
   ПБЭ № 3. Заготовка универсального ПБЭ вытяжной установки
   для последующего применения с ШУВ-К, корпус 3.
   Программа: Программа_ST_1

   ОБЛАСТЬ РАЗРАБОТКИ (ТЗ, приложение 1, часть 2):
     Разрабатываются окна, параметры отображаемых значений и элементов
     управления, внутренние связи. Работа проверяется на ТЕСТОВЫХ ЗНАЧЕНИЯХ.
     НЕ реализуются: полный набор переменных ШУВ-К, обработка данных приводов,
     логика резерва, общие команды шкафа, назначение входов Q7...QB.

   Разбор битовых масок НЕ выполняется: состав ШУВ-К не определён,
   маски не заданы, аварии приняты отдельными BOOL (ТЗ, п. 3).

   Планировщик и кнопка "РАСПИСАНИЕ" отсутствуют (ТЗ, п. 3.1).
   ============================================================================ *)

VAR
    v : INT;
END_VAR

(* ---------------------------------------------------------------------------
   1. ОГРАНИЧЕНИЕ ВВОДИМЫХ УСТАВОК
      Уставки вводятся оператором в окнах "Настройки (уставки)" и на
      мнемосхеме. Ограничиваем диапазоны функцией LIMIT, чтобы введённое
      значение не выходило за физически осмысленные пределы.
   --------------------------------------------------------------------------- *)

ЗадТПритока.Value  := LIMIT(MN := 5.0,  IN := ЗадТПритока.Value,  MX := 40.0);
УстТПритока.Value  := LIMIT(MN := 5.0,  IN := УстТПритока.Value,  MX := 40.0);
УстТВытяжки.Value  := LIMIT(MN := 5.0,  IN := УстТВытяжки.Value,  MX := 40.0);
МинТПритока.Value  := LIMIT(MN := 0.0,  IN := МинТПритока.Value,  MX := 30.0);
ТПереходаЛето.Value := LIMIT(MN := 0.0, IN := ТПереходаЛето.Value, MX := 30.0);
ТПереходаЗима.Value := LIMIT(MN := -30.0, IN := ТПереходаЗима.Value, MX := 10.0);

(* Уставки скорости - целые, 0...100 % *)
IF ЗадVПритока.Value < 0 THEN
    ЗадVПритока.Value := 0;
ELSIF ЗадVПритока.Value > 100 THEN
    ЗадVПритока.Value := 100;
END_IF;

IF ЗадVВытяжки.Value < 0 THEN
    ЗадVВытяжки.Value := 0;
ELSIF ЗадVВытяжки.Value > 100 THEN
    ЗадVВытяжки.Value := 100;
END_IF;

(* ---------------------------------------------------------------------------
   2. ЗЕРКАЛЬНЫЙ ПРИЗНАК "ОТКЛЮЧЕНА"
      По образцу (рис. А.1) в элементе присутствуют оба параметра:
      "Включена" и "Отключена".
   --------------------------------------------------------------------------- *)

Отключена.Value := NOT Включена.Value;

(* ---------------------------------------------------------------------------
   3. КОМАНДЫ ПО ОТКЛЮЧЁННЫМ ФУНКЦИЯМ НЕ ФОРМИРУЮТСЯ
      ТЗ, п. 1.3 и п. 3.2: неприменимые компоненты и функции отключаются
      настройками экземпляра, соответствующая графика скрывается, команды
      по отключённым функциям не формируются.
      Вентилятор 2 (резервный) присутствует только при НастрЕстьВент2 = TRUE.
   --------------------------------------------------------------------------- *)

IF NOT НастрЕстьВент2.Value THEN
    ПускВент2.Value := FALSE;
    СтопВент2.Value := FALSE;
END_IF;

(* Взаимоисключение команд пуска и останова по одному узлу *)
IF ПускВент1.Value AND СтопВент1.Value THEN
    ПускВент1.Value := FALSE;
END_IF;

IF ПускВент2.Value AND СтопВент2.Value THEN
    ПускВент2.Value := FALSE;
END_IF;

(* ---------------------------------------------------------------------------
   4. СОСТОЯНИЕ ЗАСЛОНОК
      Текст формируется по концевым выключателям.
      При отключённой настройкой заслонке текст принудительно "Нет данных";
      графика скрыта входящей связью на свойство "Видимость".
   --------------------------------------------------------------------------- *)

IF NOT НастрЕстьЗаслонкаПриток.Value THEN
    ЗаслонкаПритокТекст.Value := "Нет данных";
ELSIF ЗаслонкаПритокОткрыта.Value THEN
    ЗаслонкаПритокТекст.Value := "Открыта";
ELSIF ЗаслонкаПритокЗакрыта.Value THEN
    ЗаслонкаПритокТекст.Value := "Закрыта";
ELSE
    ЗаслонкаПритокТекст.Value := "Нет данных";
END_IF;

IF NOT НастрЕстьЗаслонкаВытяж.Value THEN
    ЗаслонкаВытяжТекст.Value := "Нет данных";
ELSIF ЗаслонкаВытяжОткрыта.Value THEN
    ЗаслонкаВытяжТекст.Value := "Открыта";
ELSIF ЗаслонкаВытяжЗакрыта.Value THEN
    ЗаслонкаВытяжТекст.Value := "Закрыта";
ELSE
    ЗаслонкаВытяжТекст.Value := "Нет данных";
END_IF;

(* ---------------------------------------------------------------------------
   5. ПЕРЕСЧЁТ ПРОЦЕНТОВ В РАСХОД
      Номинальные расходы задаются настройкой экземпляра.
      Если номинал не задан (0), расход остаётся нулевым.
   --------------------------------------------------------------------------- *)

РасходВытяжки.Value := VВытяжки.Value * НомРасходаВытяжки.Value / 100.0;
РасходПритока.Value := VПритока.Value * НомРасходаПритока.Value / 100.0;

(* ---------------------------------------------------------------------------
   6. АВАРИИ И ПРЕДУПРЕЖДЕНИЯ
      Аварии приходят ОТДЕЛЬНЫМИ BOOL - разбор битовых масок не выполняется
      (ТЗ, п. 3). Код аварии/предупреждения равен -1 при отсутствии
      (по образцу, рис. А.2).
      Аварии отключённых настройкой узлов не учитываются.
   --------------------------------------------------------------------------- *)

v := 0;

(* Аварийные признаки, действующие всегда *)
IF АвПожар.Value   THEN v := 1; END_IF;
IF АвОбщая.Value   THEN v := 1; END_IF;
IF АвВент1.Value   THEN v := 1; END_IF;

(* Признаки, зависящие от состава оборудования *)
IF НастрЕстьВент2.Value      AND АвВент2.Value        THEN v := 1; END_IF;
IF НастрЕстьЗаслонкаПриток.Value AND АвЗаслонкаПриток.Value THEN v := 1; END_IF;
IF НастрЕстьЗаслонкаВытяж.Value  AND АвЗаслонкаВытяж.Value  THEN v := 1; END_IF;
IF НастрЕстьФильтр.Value     AND АвФильтр.Value       THEN v := 1; END_IF;
IF НастрЕстьНагреватель.Value AND АвНагреватель.Value THEN v := 1; END_IF;

(* Потеря связи сама по себе не является аварией, но подавляет доверие
   к аварийным признакам. Состояние при этом "Нет данных". *)

ЕстьАвария.Value   := (v > 0) AND NOT ДиагНетСвязи.Value;
ОбщаяАвария.Value  := ЕстьАвария.Value;
Авария.Value       := ЕстьАвария.Value;

IF ЕстьАвария.Value THEN
    КодАварии.Value := 1;
ELSE
    КодАварии.Value := -1;
END_IF;

(* Предупреждения *)
ЕстьПредупр.Value := Блокировка.Value AND NOT ДиагНетСвязи.Value;

IF ЕстьПредупр.Value THEN
    КодПредупр.Value := 1;
ELSE
    КодПредупр.Value := -1;
END_IF;

(* ---------------------------------------------------------------------------
   7. СОСТОЯНИЕ УСТАНОВКИ
      Приоритет: Авария > Нет связи > Блокировка (Предупреждение) >
                 Работа > Стоп
   --------------------------------------------------------------------------- *)

IF ЕстьАвария.Value THEN
    СостояниеУст.Value := 3;
ELSIF ДиагНетСвязи.Value THEN
    СостояниеУст.Value := 4;
ELSIF Блокировка.Value THEN
    СостояниеУст.Value := 2;
ELSIF Включена.Value AND РаботаВент1.Value THEN
    СостояниеУст.Value := 1;
ELSE
    СостояниеУст.Value := 0;
END_IF;

CASE СостояниеУст.Value OF
    0: СостояниеУстТекст.Value := "Стоп";
    1: СостояниеУстТекст.Value := "Работа";
    2: СостояниеУстТекст.Value := "Предупреждение";
    3: СостояниеУстТекст.Value := "Авария";
    4: СостояниеУстТекст.Value := "Нет данных";
ELSE
    СостояниеУстТекст.Value := "Нет данных";
END_CASE;

(* Текущий режим текстом *)
CASE ЗадРежима.Value OF
    0: ТекущийРежим.Value := "Авто";
    1: ТекущийРежим.Value := "Ручной";
    2: ТекущийРежим.Value := "Стоп";
ELSE
    ТекущийРежим.Value := "Нет данных";
END_CASE;

(* Состояние системы для панели "Состояние" *)
IF ДиагНетСвязи.Value THEN
    СостояниеСистемы.Value := "Нет данных";
ELSIF ЕстьАвария.Value THEN
    СостояниеСистемы.Value := "Авария";
ELSIF СостояниеУст.Value = 1 THEN
    СостояниеСистемы.Value := "Работа";
ELSE
    СостояниеСистемы.Value := "Остановлена";
END_IF;

(* Конец программы ПБЭ № 3 *)
