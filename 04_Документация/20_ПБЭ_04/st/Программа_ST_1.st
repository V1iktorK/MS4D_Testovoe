(* ============================================================================
   ПБЭ № 4. Универсальный ПБЭ группы вытяжных установок без ПЛК, корпус 3.
   Программа: Программа_ST_1
   Назначение: вычисление состояния каждой из пяти установок и агрегатов группы.
   Только мониторинг. Команды в оборудование НЕ формируются.
   Аварии приходят отдельными BOOL - разбор битовых масок не выполняется
   (ТЗ, п. 3; ТЗ, приложение 1, часть 2, ПБЭ № 4).
   Группа: В1.1, В2.1, В3.1, В7, В9.
   ============================================================================ *)

VAR
    i : INT;
END_VAR

(* ---- Состояние установки 1 (В1.1) ---- *)
(* Приоритет: авария > нет связи > работа > стоп.
   Значения: 0 - Стоп, 1 - Работа, 2 - Предупреждение, 3 - Авария, 4 - Нет связи *)
IF АвАвария1.Value THEN
    Состояние1.Value := 3;
ELSIF ДиагНетСвязи1.Value THEN
    Состояние1.Value := 4;
ELSIF Работа1.Value THEN
    Состояние1.Value := 1;
ELSE
    Состояние1.Value := 0;
END_IF;

IF Состояние1.Value = 0 THEN
    Состояние1Текст.Value := "Стоп";
ELSIF Состояние1.Value = 1 THEN
    Состояние1Текст.Value := "Работа";
ELSIF Состояние1.Value = 2 THEN
    Состояние1Текст.Value := "Предупреждение";
ELSIF Состояние1.Value = 3 THEN
    Состояние1Текст.Value := "Авария";
ELSE
    Состояние1Текст.Value := "Нет данных";
END_IF;

ЕстьАвария1.Value := АвАвария1.Value AND NOT ДиагНетСвязи1.Value;

(* ---- Состояние установки 2 (В2.1) ---- *)
IF АвАвария2.Value THEN
    Состояние2.Value := 3;
ELSIF ДиагНетСвязи2.Value THEN
    Состояние2.Value := 4;
ELSIF Работа2.Value THEN
    Состояние2.Value := 1;
ELSE
    Состояние2.Value := 0;
END_IF;

IF Состояние2.Value = 0 THEN
    Состояние2Текст.Value := "Стоп";
ELSIF Состояние2.Value = 1 THEN
    Состояние2Текст.Value := "Работа";
ELSIF Состояние2.Value = 2 THEN
    Состояние2Текст.Value := "Предупреждение";
ELSIF Состояние2.Value = 3 THEN
    Состояние2Текст.Value := "Авария";
ELSE
    Состояние2Текст.Value := "Нет данных";
END_IF;

ЕстьАвария2.Value := АвАвария2.Value AND NOT ДиагНетСвязи2.Value;

(* ---- Состояние установки 3 (В3.1) ---- *)
IF АвАвария3.Value THEN
    Состояние3.Value := 3;
ELSIF ДиагНетСвязи3.Value THEN
    Состояние3.Value := 4;
ELSIF Работа3.Value THEN
    Состояние3.Value := 1;
ELSE
    Состояние3.Value := 0;
END_IF;

IF Состояние3.Value = 0 THEN
    Состояние3Текст.Value := "Стоп";
ELSIF Состояние3.Value = 1 THEN
    Состояние3Текст.Value := "Работа";
ELSIF Состояние3.Value = 2 THEN
    Состояние3Текст.Value := "Предупреждение";
ELSIF Состояние3.Value = 3 THEN
    Состояние3Текст.Value := "Авария";
ELSE
    Состояние3Текст.Value := "Нет данных";
END_IF;

ЕстьАвария3.Value := АвАвария3.Value AND NOT ДиагНетСвязи3.Value;

(* ---- Состояние установки 4 (В7) ---- *)
IF АвАвария4.Value THEN
    Состояние4.Value := 3;
ELSIF ДиагНетСвязи4.Value THEN
    Состояние4.Value := 4;
ELSIF Работа4.Value THEN
    Состояние4.Value := 1;
ELSE
    Состояние4.Value := 0;
END_IF;

IF Состояние4.Value = 0 THEN
    Состояние4Текст.Value := "Стоп";
ELSIF Состояние4.Value = 1 THEN
    Состояние4Текст.Value := "Работа";
ELSIF Состояние4.Value = 2 THEN
    Состояние4Текст.Value := "Предупреждение";
ELSIF Состояние4.Value = 3 THEN
    Состояние4Текст.Value := "Авария";
ELSE
    Состояние4Текст.Value := "Нет данных";
END_IF;

ЕстьАвария4.Value := АвАвария4.Value AND NOT ДиагНетСвязи4.Value;

(* ---- Состояние установки 5 (В9) ---- *)
IF АвАвария5.Value THEN
    Состояние5.Value := 3;
ELSIF ДиагНетСвязи5.Value THEN
    Состояние5.Value := 4;
ELSIF Работа5.Value THEN
    Состояние5.Value := 1;
ELSE
    Состояние5.Value := 0;
END_IF;

IF Состояние5.Value = 0 THEN
    Состояние5Текст.Value := "Стоп";
ELSIF Состояние5.Value = 1 THEN
    Состояние5Текст.Value := "Работа";
ELSIF Состояние5.Value = 2 THEN
    Состояние5Текст.Value := "Предупреждение";
ELSIF Состояние5.Value = 3 THEN
    Состояние5Текст.Value := "Авария";
ELSE
    Состояние5Текст.Value := "Нет данных";
END_IF;

ЕстьАвария5.Value := АвАвария5.Value AND NOT ДиагНетСвязи5.Value;

(* ---- Состояние заслонок - только для установок, где заслонка предусмотрена ---- *)
(* НастрЕстьЗаслонкаN = FALSE -> текст "Нет данных", графика скрыта связью "Видимость" *)

IF NOT НастрЕстьЗаслонка1.Value THEN
    Заслонка1Текст.Value := "Нет данных";
ELSIF ЗаслонкаОткрыта1.Value THEN
    Заслонка1Текст.Value := "Открыта";
ELSIF ЗаслонкаЗакрыта1.Value THEN
    Заслонка1Текст.Value := "Закрыта";
ELSE
    Заслонка1Текст.Value := "Нет данных";
END_IF;

IF NOT НастрЕстьЗаслонка2.Value THEN
    Заслонка2Текст.Value := "Нет данных";
ELSIF ЗаслонкаОткрыта2.Value THEN
    Заслонка2Текст.Value := "Открыта";
ELSIF ЗаслонкаЗакрыта2.Value THEN
    Заслонка2Текст.Value := "Закрыта";
ELSE
    Заслонка2Текст.Value := "Нет данных";
END_IF;

IF NOT НастрЕстьЗаслонка3.Value THEN
    Заслонка3Текст.Value := "Нет данных";
ELSIF ЗаслонкаОткрыта3.Value THEN
    Заслонка3Текст.Value := "Открыта";
ELSIF ЗаслонкаЗакрыта3.Value THEN
    Заслонка3Текст.Value := "Закрыта";
ELSE
    Заслонка3Текст.Value := "Нет данных";
END_IF;

IF NOT НастрЕстьЗаслонка4.Value THEN
    Заслонка4Текст.Value := "Нет данных";
ELSIF ЗаслонкаОткрыта4.Value THEN
    Заслонка4Текст.Value := "Открыта";
ELSIF ЗаслонкаЗакрыта4.Value THEN
    Заслонка4Текст.Value := "Закрыта";
ELSE
    Заслонка4Текст.Value := "Нет данных";
END_IF;

IF NOT НастрЕстьЗаслонка5.Value THEN
    Заслонка5Текст.Value := "Нет данных";
ELSIF ЗаслонкаОткрыта5.Value THEN
    Заслонка5Текст.Value := "Открыта";
ELSIF ЗаслонкаЗакрыта5.Value THEN
    Заслонка5Текст.Value := "Закрыта";
ELSE
    Заслонка5Текст.Value := "Нет данных";
END_IF;

(* ---- Агрегаты группы ---- *)
КолРаботают.Value := 0;
КолАварий.Value   := 0;

FOR i := 1 TO 5 DO
    IF i = 1 THEN
        IF Состояние1.Value = 1 THEN КолРаботают.Value := КолРаботают.Value + 1; END_IF;
        IF ЕстьАвария1.Value THEN КолАварий.Value := КолАварий.Value + 1; END_IF;
    ELSIF i = 2 THEN
        IF Состояние2.Value = 1 THEN КолРаботают.Value := КолРаботают.Value + 1; END_IF;
        IF ЕстьАвария2.Value THEN КолАварий.Value := КолАварий.Value + 1; END_IF;
    ELSIF i = 3 THEN
        IF Состояние3.Value = 1 THEN КолРаботают.Value := КолРаботают.Value + 1; END_IF;
        IF ЕстьАвария3.Value THEN КолАварий.Value := КолАварий.Value + 1; END_IF;
    ELSIF i = 4 THEN
        IF Состояние4.Value = 1 THEN КолРаботают.Value := КолРаботают.Value + 1; END_IF;
        IF ЕстьАвария4.Value THEN КолАварий.Value := КолАварий.Value + 1; END_IF;
    ELSIF i = 5 THEN
        IF Состояние5.Value = 1 THEN КолРаботают.Value := КолРаботают.Value + 1; END_IF;
        IF ЕстьАвария5.Value THEN КолАварий.Value := КолАварий.Value + 1; END_IF;
    END_IF;
END_FOR;

ЕстьАвария.Value := КолАварий.Value > 0;

ДиагНетСвязи.Value := ДиагНетСвязи1.Value
                  OR ДиагНетСвязи2.Value
                  OR ДиагНетСвязи3.Value
                  OR ДиагНетСвязи4.Value
                  OR ДиагНетСвязи5.Value;

(* Конец программы ПБЭ № 4 *)
