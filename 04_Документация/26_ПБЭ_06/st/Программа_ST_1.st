(* ============================================================================
   ПБЭ № 6. Универсальный ПБЭ вытяжной установки - Carel µAria, корпус 8.
   Программа: Программа_ST_1

   Экземпляры: 13
     ШУВ1: В1, В4, В6                       (3)
     ШУВ2: В2.1, В2.2, В3.1, В3.2, В5, В7,
           В8, В9, В10, В11                  (10)

   Один экземпляр - одна вытяжная установка, В ТОМ ЧИСЛЕ ПРИ ОБЩЕМ ШКАФЕ
   УПРАВЛЕНИЯ. Индивидуальные сигналы установок и общие команды группы
   ОБОЗНАЧАЮТСЯ ОТДЕЛЬНО (ТЗ, приложение 1, часть 2, ПБЭ № 6).

   АВАРИИ ПРИХОДЯТ ОТДЕЛЬНЫМИ ЛОГИЧЕСКИМИ ПРИЗНАКАМИ.
   Разбор битовых масок НЕ ВЫПОЛНЯЕТСЯ: масок DINT нет, GetBit не вызывается
   (ТЗ, п. 3; приложение 1, часть 2 - µAria).

   Реализованы требуемые механизмы:
     - ЗАДЕРЖКИ ТРЕВОГ (подтверждение и отпускание);
     - ИНДИКАЦИЯ ОСНОВНОЙ И РЕЗЕРВНОЙ РАБОТЫ;
     - состояния и команды вентиляторов;
     - ГРУППОВЫЕ КОМАНДЫ шкафа (общий шкаф управления).

   Состав оборудования и применимые функции выбираются настройками
   экземпляра; команды по отключённым функциям не формируются (ТЗ, п. 1.3).

   Планировщик - по ТЗ, п. 3.2. Команды формируются ТОЛЬКО через параметры
   экземпляра ПБЭ. Запись расписания во встроенные программы контроллеров
   НЕ ПРЕДУСМОТРЕНА.

   Ротация вентиляторов по наработке НЕ выполняется: ТЗ для ПБЭ № 6 требует
   ИНДИКАЦИИ основной и резервной работы, а ротация - требование ПБЭ № 2.
   ============================================================================ *)

VAR
    (* --- задержки тревог --- *)
    СекТревоги  : INT;
    СекПредупр  : INT;
    СекОтпуск   : INT;
    ЗадержкаТревогиСек : INT;   (* рабочая: задержка тревоги в секундах *)
    ЗадержкаПредупрСек : INT;   (* рабочая: задержка предупреждения *)
    ЗадержкаОтпускСек  : INT;   (* рабочая: задержка отпускания *)
    ТаймерКрит  : INT;   (* счётчик подтверждения критических признаков *)
    ТаймерПред  : INT;   (* счётчик подтверждения предупредительных *)
    ТаймерОтпК  : INT;   (* счётчик отпускания критических *)
    ТаймерОтпП  : INT;   (* счётчик отпускания предупредительных *)
    СыраяКрит   : BOOL;  (* есть неподтверждённый критический признак *)
    СыраяПред   : BOOL;

    (* --- групповые команды --- *)
    ГруппаВкл   : BOOL;

    (* --- планировщик --- *)
    День   : STRING;   (* текущий день недели, принят из СистемаДеньНеделиТекст *)
    Час    : INT;      (* текущий час, принят из СистемаЧас *)
    Мин    : INT;      (* текущая минута, принята из СистемаМин *)
    ТекСек : INT;
    НачСек : INT;
    КонСек : INT;
    Акт1   : BOOL;
    Акт2   : BOOL;

    (* --- прочее --- *)
    АвВент   : BOOL;     (* авария текущего основного вентилятора *)
    ИнкМч1   : REAL;
    ИнкМч2   : REAL;
END_VAR

(* ===========================================================================
   1. ОГРАНИЧЕНИЕ ВВОДИМЫХ УСТАВОК
   =========================================================================== *)

ЗадТВытяжки.Value := LIMIT(MN := 5.0,  IN := ЗадТВытяжки.Value,  MX := 40.0);
УстТВытяжки.Value := LIMIT(MN := 5.0,  IN := УстТВытяжки.Value,  MX := 40.0);
МинТВытяжки.Value := LIMIT(MN := 0.0,  IN := МинТВытяжки.Value,  MX := 30.0);
ТПереходаЛето.Value := LIMIT(MN := 0.0, IN := ТПереходаЛето.Value, MX := 30.0);
ТПереходаЗима.Value := LIMIT(MN := -30.0, IN := ТПереходаЗима.Value, MX := 10.0);
СкоростьСниженияСтартВыдержки.Value := LIMIT(MN := 0.0, IN := СкоростьСниженияСтартВыдержки.Value, MX := 100.0);

IF ЗадVВытяжки.Value < 0 THEN
    ЗадVВытяжки.Value := 0;
ELSIF ЗадVВытяжки.Value > 100 THEN
    ЗадVВытяжки.Value := 100;
END_IF;

IF ЗадVПритока.Value < 0 THEN
    ЗадVПритока.Value := 0;
ELSIF ЗадVПритока.Value > 100 THEN
    ЗадVПритока.Value := 100;
END_IF;

IF ВыборОсновногоВент.Value < 1 THEN
    ВыборОсновногоВент.Value := 1;
ELSIF ВыборОсновногоВент.Value > 3 THEN
    ВыборОсновногоВент.Value := 1;
END_IF;

IF ПериодПереключенияВент.Value < 1 THEN
    ПериодПереключенияВент.Value := 1;
END_IF;

(* Шаг программы в секундах для задержек и моточасов *)
IF ШагПрограммыСек.Value < 0.001 THEN
    ШагПрограммыСек.Value := 0.001;
ELSIF ШагПрограммыСек.Value > 3600.0 THEN
    ШагПрограммыСек.Value := 3600.0;
END_IF;

(* ===========================================================================
   2. ПРИМЕНИМОСТЬ: ОТКЛЮЧЁННЫЕ НАСТРОЙКОЙ УЗЛЫ И ФУНКЦИИ
      ТЗ, п. 1.3: команды по отключённым функциям не формируются.
   =========================================================================== *)

(* Вентилятор 2 отсутствует *)
IF NOT НастрЕстьВент2.Value THEN
    ПускВент2.Value := FALSE;
    СтопВент2.Value := TRUE;
    РезервАктивен.Value := FALSE;
    ОбаВентилятораВРаботе.Value := FALSE;
    МчВент2.Value := 0;
    МчВент2Дроб.Value := 0.0;
    IF ВыборОсновногоВент.Value = 2 THEN
        ВыборОсновногоВент.Value := 1;
    END_IF;
END_IF;

(* Функция резервирования выключена *)
IF NOT НастрФункцияРезерв.Value THEN
    РезервАктивен.Value := FALSE;
    АВРСработал.Value := FALSE;
    РучноеПереключение.Value := FALSE;
    ОсновнойВент.Value := 1;
END_IF;

(* Рекуператор отсутствует *)
IF NOT НастрЕстьРекуператор.Value THEN
    РаботаРекуператора.Value := FALSE;
END_IF;

(* Клапан отсутствует *)
IF NOT НастрЕстьКлапан.Value THEN
    КлапанОткрыт.Value := FALSE;
    КлапанЗакрыт.Value := TRUE;
END_IF;

(* Функция задания скорости выключена *)
IF NOT НастрФункцияСкорость.Value THEN
    ЗадVВытяжки.Value := 0;
    ЗадVПритока.Value := 0;
END_IF;

(* Функция задания температуры выключена *)
IF NOT НастрФункцияТемпература.Value THEN
    ЗадТВытяжки.Value := 0.0;
    УстТВытяжки.Value := 0.0;
END_IF;

(* Узел датчика наружного воздуха отсутствует *)
IF NOT НастрЕстьТНарВозд.Value THEN
    АвДатчикТНарВозд.Value := FALSE;
END_IF;

(* Задержки отключены - тревога срабатывает мгновенно.
   ВНИМАНИЕ: литерал 0 для типа TIME. Если среда потребует явного
   TIME-литерала, заменить на T#0s (см. допущение D-63 в 99_Допущения.md).
   Значение 0 корректно при любом представлении TIME, поэтому риск минимален. *)
IF NOT НастрФункцияЗадержки.Value THEN
    ЗадержкаТревоги.Value  := 0;
    ЗадержкаПредупр.Value  := 0;
    ЗадержкаОтпускания.Value := 0;
END_IF;

(* ===========================================================================
   3. ГРУППОВЫЕ КОМАНДЫ ОБЩЕГО ШКАФА УПРАВЛЕНИЯ
      ТЗ, приложение 1, часть 2: "Индивидуальные сигналы установок и общие
      команды группы обозначаются отдельно".
      Групповая команда НЕ подменяет индивидуальную: оператор сохраняет
      индивидуальное управление установкой.
   =========================================================================== *)

ГруппаВкл := FALSE;

IF НастрФункцияГруппа.Value THEN

    (* Общая команда шкафа "пуск" - действует на установку *)
    IF ГрВклШкафа.Value AND NOT ГрСтопШкафа.Value THEN
        ГруппаВкл := TRUE;
        ГрКомандаПринята.Value := TRUE;
    ELSE
        ГрКомандаПринята.Value := FALSE;
    END_IF;

    (* Общий сброс аварий шкафа *)
    IF ГрСбросАварий.Value THEN
        СбросАварии.Value := TRUE;
    END_IF;

    (* Общее аварийное отключение шкафа - приоритет выше всех команд *)
    IF ГрАварийноеОтключение.Value THEN
        Включена.Value := FALSE;
        ГруппаВкл := FALSE;
    END_IF;

    (* Общая команда переключения резерва по шкафу *)
    IF ГрПереключениеРезерва.Value AND НастрЕстьВент2.Value
       AND НастрФункцияРезерв.Value THEN
        РучноеПереключение.Value := TRUE;
    END_IF;

ELSE
    (* Групповое управление отключено настройкой: команды шкафа не принимаются *)
    ГрКомандаПринята.Value := FALSE;
END_IF;

(* ===========================================================================
   4. ЗАДЕРЖКИ ТРЕВОГ
      ТЗ, приложение 1, часть 2: "задержки тревог".
      Назначение: кратковременный сигнал (дребезг контакта, пусковой бросок)
      не должен немедленно поднимать тревогу.
      Реализация - счётчик секунд: ТОН и TOF библиотечные ФБ здесь не
      используются, чтобы не зависеть от формы объявления их экземпляров
      в этой сборке. Шаг счёта - параметр ШагПрограммыСек.
   =========================================================================== *)

ЗадержкаТревогиСек := TIME_TO_INT(IN := ЗадержкаТревоги.Value);
ЗадержкаПредупрСек := TIME_TO_INT(IN := ЗадержкаПредупр.Value);
ЗадержкаОтпускСек  := TIME_TO_INT(IN := ЗадержкаОтпускания.Value);

СекТревоги := ЗадержкаТревогиСек;
СекПредупр := ЗадержкаПредупрСек;
СекОтпуск  := ЗадержкаОтпускСек;

IF СекТревоги < 0 THEN СекТревоги := 0; END_IF;
IF СекПредупр < 0 THEN СекПредупр := 0; END_IF;
IF СекОтпуск  < 0 THEN СекОтпуск  := 0; END_IF;

(* --- 4.1. Сырые (незадержанные) признаки -------------------------------- *)

СыраяКрит := FALSE;
СыраяПред := FALSE;

(* Критические признаки, действующие всегда *)
IF Пожар.Value                 THEN СыраяКрит := TRUE; END_IF;
IF АвЗаслВыт.Value             THEN СыраяКрит := TRUE; END_IF;
IF АвЗаслПрит.Value            THEN СыраяКрит := TRUE; END_IF;
IF АвВент1.Value               THEN СыраяКрит := TRUE; END_IF;
IF АвВент2.Value AND НастрЕстьВент2.Value THEN СыраяКрит := TRUE; END_IF;
IF АвПерепадВент1.Value        THEN СыраяКрит := TRUE; END_IF;
IF АвПерепадВент2.Value AND НастрЕстьВент2.Value THEN СыраяКрит := TRUE; END_IF;
IF АвФильтрВыт.Value           THEN СыраяКрит := TRUE; END_IF;
IF АвНагреватель.Value         THEN СыраяКрит := TRUE; END_IF;
IF АвЗаслонкаВытНеОткр.Value   THEN СыраяКрит := TRUE; END_IF;
IF АвОшибкаПоложЗаслВыт.Value  THEN СыраяКрит := TRUE; END_IF;

(* Признаки, зависящие от состава оборудования *)
IF НастрЕстьРекуператор.Value AND АвРекуператор.Value THEN СыраяКрит := TRUE; END_IF;
IF НастрЕстьКлапан.Value      AND АвКлапан.Value      THEN СыраяКрит := TRUE; END_IF;
IF НастрЕстьНагреватель.Value AND АвНагреватель.Value THEN СыраяКрит := TRUE; END_IF;

(* Групповые аварийные признаки *)
IF ГрАвШкафа.Value         THEN СыраяКрит := TRUE; END_IF;
IF ГрАвПитанияШкафа.Value  THEN СыраяКрит := TRUE; END_IF;

(* Предупредительные признаки *)
IF АвТермостат1.Value     THEN СыраяПред := TRUE; END_IF;
IF АвТермостат2.Value     THEN СыраяПред := TRUE; END_IF;
IF АвНизкаяТВытяжки.Value THEN СыраяПред := TRUE; END_IF;
IF АвДатчикТНарВозд.Value THEN СыраяПред := TRUE; END_IF;
IF АвДатчикТВытяжки.Value THEN СыраяПред := TRUE; END_IF;
IF АвПрогревЗимой.Value   THEN СыраяПред := TRUE; END_IF;
IF АвФильтрЗасорен.Value  THEN СыраяПред := TRUE; END_IF;
IF Предупреждение.Value   THEN СыраяПред := TRUE; END_IF;
IF Блокировка.Value       THEN СыраяПред := TRUE; END_IF;

(* --- 4.2. Подтверждение критических признаков (задержка появления) ------ *)

IF СыраяКрит THEN

    IF СекТревоги = 0 THEN
        ТаймерКрит := 0;
        ТревогаПодтверждена.Value := TRUE;
    ELSE
        IF ТаймерКрит < СекТревоги THEN
            ТаймерКрит := ТаймерКрит + ШагПрограммыСек.Value;
            IF ТаймерКрит >= СекТревоги THEN
                ТаймерКрит := СекТревоги;
                ТревогаПодтверждена.Value := TRUE;
            ELSE
                ТревогаПодтверждена.Value := FALSE;
            END_IF;
        ELSE
            ТревогаПодтверждена.Value := TRUE;
        END_IF;
    END_IF;

ELSE
    (* Признак исчез - сброс счётчика подтверждения *)
    ТаймерКрит := 0;

    (* Задержка отпускания: тревога держится ещё СекОтпуск секунд *)
    IF СекОтпуск = 0 THEN
        ТревогаПодтверждена.Value := FALSE;
    ELSE
        IF ТревогаПодтверждена.Value THEN
            ТаймерОтпК := ТаймерОтпК + ШагПрограммыСек.Value;
            IF ТаймерОтпК >= СекОтпуск THEN
                ТаймерОтпК := 0;
                ТревогаПодтверждена.Value := FALSE;
            END_IF;
        ELSE
            ТаймерОтпК := 0;
        END_IF;
    END_IF;
END_IF;

(* --- 4.3. Подтверждение предупредительных признаков -------------------- *)

IF СыраяПред THEN

    IF СекПредупр = 0 THEN
        ТаймерПред := 0;
        ЕстьПредупр.Value := TRUE;
    ELSE
        IF ТаймерПред < СекПредупр THEN
            ТаймерПред := ТаймерПред + ШагПрограммыСек.Value;
            IF ТаймерПред >= СекПредупр THEN
                ТаймерПред := СекПредупр;
                ЕстьПредупр.Value := TRUE;
            ELSE
                ЕстьПредупр.Value := FALSE;
            END_IF;
        ELSE
            ЕстьПредупр.Value := TRUE;
        END_IF;
    END_IF;

ELSE
    ТаймерПред := 0;

    IF СекОтпуск = 0 THEN
        ЕстьПредупр.Value := FALSE;
    ELSE
        IF ЕстьПредупр.Value THEN
            ТаймерОтпП := ТаймерОтпП + ШагПрограммыСек.Value;
            IF ТаймерОтпП >= СекОтпуск THEN
                ТаймерОтпП := 0;
                ЕстьПредупр.Value := FALSE;
            END_IF;
        ELSE
            ТаймерОтпП := 0;
        END_IF;
    END_IF;
END_IF;

(* --- 4.4. Индикация состояния таймеров ---------------------------------- *)

ТаймерТревогиИдет.Value := СыраяКрит AND NOT ТревогаПодтверждена.Value;

IF ТаймерТревогиИдет.Value THEN
    ТаймерТревогиОсталось.Value := СекТревоги - ТаймерКрит;
    IF ТаймерТревогиОсталось.Value < 0 THEN
        ТаймерТревогиОсталось.Value := 0;
    END_IF;
    ВрТревогиТекст.Value := "Задержка тревоги";
ELSE
    ТаймерТревогиОсталось.Value := 0;
    ВрТревогиТекст.Value := "";
END_IF;

(* Число признаков, находящихся в задержке (грубая оценка: 0 или 1 группа) *)
IF ТаймерТревогиИдет.Value THEN
    КолТревогВЗадержке.Value := 1;
ELSE
    КолТревогВЗадержке.Value := 0;
END_IF;

(* --- 4.5. Итоговые признаки аварии -------------------------------------- *)

IF ТревогаПодтверждена.Value THEN
    КолАварий.Value := 1;
ELSE
    КолАварий.Value := 0;
END_IF;

ЕстьАвария.Value  := ТревогаПодтверждена.Value AND NOT ДиагНетСвязи.Value;
ОбщаяАвария.Value := ЕстьАвария.Value;
Авария.Value      := ЕстьАвария.Value;

(* Код аварии: -1 при отсутствии (по образцу, рис. А.2) *)
IF ЕстьАвария.Value THEN
    КодАварии.Value := 1;
ELSE
    КодАварии.Value := -1;
END_IF;

IF ЕстьПредупр.Value THEN
    КодПредупр.Value := 1;
ELSE
    КодПредупр.Value := -1;
END_IF;

(* Групповая авария учитывается в состоянии установки *)
ГрАварияГруппы.Value := ГрАварияШкафа.Value AND НастрФункцияГруппа.Value;

(* ===========================================================================
   5. ПЛАНИРОВЩИК РАБОТЫ УСТАНОВКИ (ТЗ, п. 3.2)
   =========================================================================== *)

(* Текущий день недели и время суток принимаются ПАРАМЕТРАМИ от системы.
   Штатной функции получения текущего времени в проверенном перечне нет,
   поэтому значения принимаются из канала - так же, как все прочие входные
   величины ПБЭ (ТЗ, п. 3: элемент работает со своими параметрами). *)
День := СистемаДеньНеделиТекст.Value;
Час  := СистемаЧас.Value;
Мин  := СистемаМин.Value;

ТекСек := Час * 3600 + Мин * 60;

Акт1 := FALSE;
Акт2 := FALSE;

IF День = "Пн" THEN

    НачСек := ПланПн1НачалоЧ.Value * 3600 + ПланПн1НачалоМин.Value * 60;
    КонСек := ПланПн1КонецЧ.Value  * 3600 + ПланПн1КонецМин.Value  * 60;
    IF ПланПн1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланПн2Активация.Value THEN
        НачСек := ПланПн2НачалоЧ.Value * 3600 + ПланПн2НачалоМин.Value * 60;
        КонСек := ПланПн2КонецЧ.Value  * 3600 + ПланПн2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

ELSIF День = "Вт" THEN

    НачСек := ПланВт1НачалоЧ.Value * 3600 + ПланВт1НачалоМин.Value * 60;
    КонСек := ПланВт1КонецЧ.Value  * 3600 + ПланВт1КонецМин.Value  * 60;
    IF ПланВт1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
