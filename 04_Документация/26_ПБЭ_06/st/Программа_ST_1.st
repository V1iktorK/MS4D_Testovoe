(* Применение команд расписания к параметрам ПБЭ.
   ТЗ, п. 3.2: команды формируются ТОЛЬКО через параметры экземпляра ПБЭ.
   Приоритет источников: ОПЕРАТОР > ШКАФ > РАСПИСАНИЕ. *)
КомандаПоРасписанию.Value := FALSE;

IF ПланРасписаниеАктивно.Value
   AND НастрФункцияРасписание.Value
   AND (ЗадРежима.Value <> 1)
   AND NOT Блокировка.Value
   AND NOT ДиагНетСвязи.Value THEN

    IF ПланВключить.Value THEN
        Включена.Value            := TRUE;
        КомандаПоРасписанию.Value := TRUE;
    END_IF;

    IF ПланОтключить.Value THEN
        Включена.Value            := FALSE;
        КомандаПоРасписанию.Value := TRUE;
    END_IF;

    IF НастрПланЗадT.Value AND НастрФункцияТемпература.Value AND ПланВключить.Value THEN
        ЗадТВытяжки.Value := ПланЗадT.Value;
    END_IF;

    IF НастрПланЗадV.Value AND НастрФункцияСкорость.Value AND ПланВключить.Value THEN
        ЗадVВытяжки.Value := ПланЗадV.Value;
    END_IF;

    IF НастрПланРежим.Value AND ПланВключить.Value THEN
        ЗадРежима.Value := ПланЗадРежим.Value;
    END_IF;
END_IF;

IF ПланРасписаниеАктивно.Value AND (ТекущийИнтервал.Value > 0) THEN
    КомандаПоРасписанию.Value := TRUE;
END_IF;

(* ===========================================================================
   6. КОМАНДЫ УСТАНОВКИ
      Приоритет источников: ОПЕРАТОР > ШКАФ > РАСПИСАНИЕ.
      Групповая команда дополняет индивидуальную, а не подменяет её.
   =========================================================================== *)

(* Групповая команда шкафа "пуск": включаем установку, если оператор не в ручном *)
IF ГруппаВкл AND (ЗадРежима.Value <> 1) AND NOT Блокировка.Value THEN
    Включена.Value := TRUE;
END_IF;

Отключена.Value := NOT Включена.Value;

(* Источник команды - для отображения *)
IF КомандаПоРасписанию.Value THEN
    ГрИсточникКоманды.Value := "Расписание";
ELSIF ГруппаВкл THEN
    ГрИсточникКоманды.Value := "Шкаф";
ELSE
    ГрИсточникКоманды.Value := "Оператор";
END_IF;

(* Сброс команды сброса аварий *)
IF СбросАварии.Value THEN
    СбросАварии.Value := FALSE;
END_IF;

(* ===========================================================================
   7. ИНДИКАЦИЯ ОСНОВНОЙ И РЕЗЕРВНОЙ РАБОТЫ
      ТЗ, приложение 1, часть 2: "индикация основной и резервной работы".
      Ротация по наработке НЕ выполняется - это требование ПБЭ № 2.
      Переключение возможно вручную или по АВР при аварии основного.
   =========================================================================== *)

IF ОсновнойВент.Value <> 1 AND ОсновнойВент.Value <> 2 THEN
    ОсновнойВент.Value := 1;
END_IF;

(* Жёсткий выбор основного оператором *)
IF НастрФункцияРезерв.Value AND НастрЕстьВент2.Value THEN
    IF ВыборОсновногоВент.Value = 1 THEN
        IF ОсновнойВент.Value <> 1 THEN
            ОсновнойВент.Value := 1;
            ПереключениеВыполнено.Value := TRUE;
        END_IF;
    ELSIF ВыборОсновногоВент.Value = 2 THEN
        IF ОсновнойВент.Value <> 2 THEN
            ОсновнойВент.Value := 2;
            ПереключениеВыполнено.Value := TRUE;
        END_IF;
    END_IF;
END_IF;

РезервныйВент.Value := 3 - ОсновнойВент.Value;

(* АВР: авария основного вентилятора -> вводим резервный *)
IF НастрФункцияРезерв.Value AND НастрЕстьВент2.Value
   AND NOT ДиагНетСвязи.Value THEN

    АвВент := FALSE;
    IF ОсновнойВент.Value = 1 THEN
        IF АвВент1.Value OR АвПерепадВент1.Value THEN АвВент := TRUE; END_IF;
    ELSE
        IF АвВент2.Value OR АвПерепадВент2.Value THEN АвВент := TRUE; END_IF;
    END_IF;

    IF АвВент THEN
        ОсновнойВент.Value := 3 - ОсновнойВент.Value;
        РезервныйВент.Value := 3 - ОсновнойВент.Value;
        АВРСработал.Value := TRUE;
        ПереключениеВыполнено.Value := TRUE;
    ELSIF NOT ТревогаПодтверждена.Value THEN
        АВРСработал.Value := FALSE;
    END_IF;
END_IF;

(* Ручное переключение оператором *)
IF РучноеПереключение.Value AND НастрФункцияРезерв.Value AND НастрЕстьВент2.Value THEN
    ОсновнойВент.Value := 3 - ОсновнойВент.Value;
    РезервныйВент.Value := 3 - ОсновнойВент.Value;
    АВРСработал.Value := FALSE;
    ПереключениеВыполнено.Value := TRUE;
    РучноеПереключение.Value := FALSE;
END_IF;

(* Ограничение признака "переключение выполнено" одним циклом *)
IF ПереключениеВыполнено.Value THEN
    ПереключениеВыполнено.Value := FALSE;
END_IF;

(* --- 7.1. Индикация режима работы вентиляторов --------------------------- *)

РезервАктивен.Value         := FALSE;
ОбаВентилятораВРаботе.Value := FALSE;
НиОдинНеРаботает.Value      := FALSE;

IF НастрЕстьВент2.Value THEN
    IF РаботаВент1.Value AND РаботаВент2.Value THEN
        ОбаВентилятораВРаботе.Value := TRUE;
    ELSIF NOT РаботаВент1.Value AND NOT РаботаВент2.Value THEN
        НиОдинНеРаботает.Value := TRUE;
    ELSE
        IF ОсновнойВент.Value = 1 AND РаботаВент1.Value THEN
            РезервАктивен.Value := FALSE;
        ELSIF ОсновнойВент.Value = 2 AND РаботаВент2.Value THEN
            РезервАктивен.Value := FALSE;
        ELSE
            (* работает не тот, кто назначен основным -> работает резерв *)
            РезервАктивен.Value := TRUE;
        END_IF;
    END_IF;
ELSE
    IF NOT РаботаВент1.Value THEN
        НиОдинНеРаботает.Value := TRUE;
    END_IF;
END_IF;

IF ОбаВентилятораВРаботе.Value THEN
    РежимРаботыВент.Value := "Оба в работе";
ELSIF НиОдинНеРаботает.Value THEN
    РежимРаботыВент.Value := "Ни один не работает";
ELSIF РезервАктивен.Value THEN
    IF ОсновнойВент.Value = 1 THEN
        РежимРаботыВент.Value := "Основной В1, работает резервный В2";
    ELSE
        РежимРаботыВент.Value := "Основной В2, работает резервный В1";
    END_IF;
ELSE
    IF ОсновнойВент.Value = 1 THEN
        РежимРаботыВент.Value := "Основной В1";
    ELSE
        РежимРаботыВент.Value := "Основной В2";
    END_IF;
END_IF;

РезервТекст.Value := РежимРаботыВент.Value;

(* --- 7.2. Команды вентиляторов ------------------------------------------ *)

IF Включена.Value AND NOT Блокировка.Value AND NOT ДиагНетСвязи.Value THEN

    IF ОсновнойВент.Value = 1 THEN
        ПускВент1.Value := TRUE;
        СтопВент1.Value := FALSE;
        IF НастрЕстьВент2.Value THEN
            (* Резервный вводится только при аварии основного *)
            IF АВРСработал.Value THEN
                ПускВент2.Value := TRUE;
                СтопВент2.Value := FALSE;
            ELSE
                ПускВент2.Value := FALSE;
                СтопВент2.Value := TRUE;
            END_IF;
        END_IF;
    ELSE
        ПускВент2.Value := TRUE;
        СтопВент2.Value := FALSE;
        IF АВРСработал.Value THEN
            ПускВент1.Value := TRUE;
            СтопВент1.Value := FALSE;
        ELSE
            ПускВент1.Value := FALSE;
            СтопВент1.Value := TRUE;
        END_IF;
    END_IF;

ELSE
    ПускВент1.Value := FALSE;
    СтопВент1.Value := TRUE;
    IF НастрЕстьВент2.Value THEN
        ПускВент2.Value := FALSE;
        СтопВент2.Value := TRUE;
    END_IF;
END_IF;

(* Взаимоисключение *)
IF ПускВент1.Value AND СтопВент1.Value THEN ПускВент1.Value := FALSE; END_IF;
IF ПускВент2.Value AND СтопВент2.Value THEN ПускВент2.Value := FALSE; END_IF;

(* Готовность вентиляторов *)
ГотовВент1.Value := NOT АвВент1.Value AND NOT ДиагНетСвязиВент1.Value AND NOT ДиагНетСвязи.Value;
IF НастрЕстьВент2.Value THEN
    ГотовВент2.Value := NOT АвВент2.Value AND NOT ДиагНетСвязиВент2.Value AND NOT ДиагНетСвязи.Value;
ELSE
    ГотовВент2.Value := FALSE;
END_IF;

(* --- 7.3. Моточасы (для индикации распределения наработки) --------------- *)

IF РаботаВент1.Value THEN
    ИнкМч1 := ШагПрограммыСек.Value / 3600.0;
    МчВент1Дроб.Value := МчВент1Дроб.Value + ИнкМч1;
    IF МчВент1Дроб.Value >= 1.0 THEN
        МчВент1.Value := МчВент1.Value + 1;
        МчВент1Дроб.Value := МчВент1Дроб.Value - 1.0;
    END_IF;
END_IF;

IF РаботаВент2.Value AND НастрЕстьВент2.Value THEN
    ИнкМч2 := ШагПрограммыСек.Value / 3600.0;
    МчВент2Дроб.Value := МчВент2Дроб.Value + ИнкМч2;
    IF МчВент2Дроб.Value >= 1.0 THEN
        МчВент2.Value := МчВент2.Value + 1;
        МчВент2Дроб.Value := МчВент2Дроб.Value - 1.0;
    END_IF;
END_IF;

(* ===========================================================================
   8. СОСТОЯНИЯ УЗЛОВ ТЕКСТОМ
   =========================================================================== *)

IF ЗаслонкаВытОткрыта.Value THEN
    ЗаслонкаВытТекст.Value := "Открыта";
ELSIF ЗаслонкаВытЗакрыта.Value THEN
    ЗаслонкаВытТекст.Value := "Закрыта";
ELSE
    ЗаслонкаВытТекст.Value := "Нет данных";
END_IF;

IF ЗаслонкаПритОткрыта.Value THEN
    ЗаслонкаПритТекст.Value := "Открыта";
ELSIF ЗаслонкаПритЗакрыта.Value THEN
    ЗаслонкаПритТекст.Value := "Закрыта";
ELSE
    ЗаслонкаПритТекст.Value := "Нет данных";
END_IF;

IF КлапанОткрыт.Value THEN
    КлапанТекст.Value := "Открыт";
ELSIF КлапанЗакрыт.Value THEN
    КлапанТекст.Value := "Закрыт";
ELSE
    КлапанТекст.Value := "Нет данных";
END_IF;

(* ===========================================================================
   9. РАСХОД
   =========================================================================== *)

IF ОсновнойВент.Value = 1 THEN
    РасходВытяжки.Value := VФактВент1.Value * НомРасходаВытяжки.Value / 100.0;
ELSE
    РасходВытяжки.Value := VФактВент2.Value * НомРасходаВытяжки.Value / 100.0;
END_IF;

РасходПритока.Value := 0.0;

(* ===========================================================================
   10. СОСТОЯНИЕ УСТАНОВКИ
       Приоритет: Авария > Нет связи > Предупреждение > Работа > Стоп
   =========================================================================== *)

РаботаУстановки.Value := РаботаВент1.Value OR РаботаВент2.Value;

IF ЕстьАвария.Value OR ГрАварияГруппы.Value THEN
    СостояниеУст.Value := 3;
ELSIF ДиагНетСвязи.Value THEN
    СостояниеУст.Value := 4;
ELSIF ЕстьПредупр.Value THEN
    СостояниеУст.Value := 2;
ELSIF Включена.Value AND РаботаУстановки.Value THEN
    СостояниеУст.Value := 1;
ELSE
    СостояниеУст.Value := 0;
END_IF;

CASE СостояниеУст.Value OF
    0: СостояниеУстТекст.Value := "Стоп";
    1: СостояниеУстТекст.Value := "Работа";
    2: СостояниеУстТекст.Value := "Предупреждение";
    3: СостояниеУстТекст.Value := "Авария";
    4: СостояниеУстТекст.Value := "Нет данных";
ELSE
    СостояниеУстТекст.Value := "Нет данных";
END_CASE;

CASE ЗадРежима.Value OF
    0: ТекущийРежим.Value := "Авто";
    1: ТекущийРежим.Value := "Ручной";
    2: ТекущийРежим.Value := "Стоп";
ELSE
    ТекущийРежим.Value := "Нет данных";
END_CASE;

IF ДиагНетСвязи.Value THEN
    СостояниеСистемы.Value := "Нет данных";
ELSIF ЕстьАвария.Value THEN
    СостояниеСистемы.Value := "Авария";
ELSIF СостояниеУст.Value = 1 THEN
    СостояниеСистемы.Value := "Работа";
ELSE
    СостояниеСистемы.Value := "Остановлена";
END_IF;

(* ===========================================================================
   11. СЕЗОН: ЗИМА / ЛЕТО
       ЗаданиеСезона: 0 Зима, 1 Лето, 2 Авто (селектор в окне 6.2).
       В режиме Авто сезон определяется по температуре наружного воздуха
       с ГИСТЕРЕЗИСОМ по двум уставкам:
           ТНарВозд >= ТПереходаЛето  -> Лето
           ТНарВозд <= ТПереходаЗима  -> Зима
       Между уставками сезон СОХРАНЯЕТСЯ - защита от дребезга при
       температуре около порога.
       Состояние сезона хранится в самом параметре ТекущийСезон: он
       сохраняет значение между циклами программы. Начальное значение
       "Зима" задаётся при сборке экземпляра.
       При отсутствии узла наружного воздуха (НастрЕстьТНарВозд = FALSE)
       автоматическое определение не выполняется - сезон остаётся прежним.
   =========================================================================== *)

(* Команда сезона - в допустимых пределах *)
IF ЗаданиеСезона.Value < 0 THEN
    ЗаданиеСезона.Value := 0;
ELSIF ЗаданиеСезона.Value > 2 THEN
    ЗаданиеСезона.Value := 2;
END_IF;

(* Определение сезона *)
IF ЗаданиеСезона.Value = 0 THEN
    ТекущийСезон.Value := "Зима";
ELSIF ЗаданиеСезона.Value = 1 THEN
    ТекущийСезон.Value := "Лето";
ELSIF АвДатчикТНарВозд.Value THEN
    IF ТекущийСезон.Value = "Лето" THEN
        (* Лето уже установлено: переход в Зиму только по нижнему порогу *)
        IF ТНарВозд.Value <= ТПереходаЗима.Value THEN
            ТекущийСезон.Value := "Зима";
        END_IF;
    ELSE
        (* Зима установлена: переход в Лето только по верхнему порогу *)
        IF ТНарВозд.Value >= ТПереходаЛето.Value THEN
            ТекущийСезон.Value := "Лето";
        END_IF;
    END_IF;
END_IF;

(* Конец программы ПБЭ № 6 *)
