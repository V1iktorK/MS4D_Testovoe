(* ===========================================================================
   7. СБРОС АВАРИЙ И СБРОС ЗУММЕРА
      ТЗ: "команды сброса аварий и зуммера".
      Это ДВА РАЗНЫХ действия оператора:
        - сброс аварии  - квитирование и попытка снять аварию;
        - сброс зуммера - "я слышу, иду разбираться";
          авария при этом СОХРАНЯЕТСЯ.
   =========================================================================== *)

(* --- 7.1. Сброс аварий --------------------------------------------------- *)

СбросАварийВыполнен.Value := FALSE;

IF СбросАварии.Value THEN
    АварииКвитированы.Value := TRUE;
    СбросАварийВыполнен.Value := TRUE;
    СбросАварии.Value := FALSE;
END_IF;

(* При появлении новой аварии квитирование снимается *)
IF ЕстьАвария.Value AND NOT ТревогаПодтверждена.Value THEN
    АварииКвитированы.Value := FALSE;
END_IF;

(* --- 7.2. Сброс зуммера --------------------------------------------------
   Логика:
     1. Появилась подтверждённая авария -> зуммер должен звучать.
     2. Оператор нажал "СБРОС ЗУММЕРА" -> зуммер замолкает,
        признак ЗуммерОтключенОператором := TRUE.
        ВАЖНО: авария при этом СОХРАНЯЕТСЯ (журнал, индикация, состояние).
     3. Пока авария остаётся, зуммер НЕ возобновляется.
     4. Когда все аварии сняты -> признак "отключён оператором" сбрасывается,
        чтобы СЛЕДУЮЩАЯ авария снова включила зуммер.
   ------------------------------------------------------------------------ *)

IF НастрФункцияЗуммер.Value THEN

    (* 2. Команда оператора - гасим зуммер, авария не снимается *)
    IF СбросЗуммера.Value THEN
        ЗуммерОтключенОператором.Value := TRUE;
    END_IF;

    (* 3. Все аварии сняты - операторский сброс больше не действует *)
    IF NOT ЕстьАвария.Value THEN
        ЗуммерОтключенОператором.Value := FALSE;
    END_IF;

    (* 1 и 4. Итоговое состояние зуммера *)
    ЗуммерВключен.Value := ЕстьАвария.Value AND NOT ЗуммерОтключенОператором.Value;

ELSE
    (* Функция зуммера отключена настройкой - команда не формируется *)
    ЗуммерВключен.Value := FALSE;
    ЗуммерОтключенОператором.Value := FALSE;
END_IF;

(* Сброс команды сброса зуммера после отработки *)
IF СбросЗуммера.Value THEN
    СбросЗуммера.Value := FALSE;
END_IF;

