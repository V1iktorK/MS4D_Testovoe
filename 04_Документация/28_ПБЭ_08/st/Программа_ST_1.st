ELSIF ГруппаВкл THEN
    ГрИсточникКоманды.Value := "Шкаф";
ELSE
    ГрИсточникКоманды.Value := "Оператор";
END_IF;

(* ===========================================================================
   10. ИНДИКАЦИЯ ОСНОВНОЙ И РЕЗЕРВНОЙ РАБОТЫ
   =========================================================================== *)

IF ОсновнойВент.Value <> 1 AND ОсновнойВент.Value <> 2 THEN
    ОсновнойВент.Value := 1;
END_IF;

IF НастрЕстьВент2.Value THEN
    IF ВыборОсновногоВент.Value = 1 THEN
        ОсновнойВент.Value := 1;
    ELSIF ВыборОсновногоВент.Value = 2 THEN
        ОсновнойВент.Value := 2;
    END_IF;
END_IF;

РезервныйВент.Value := 3 - ОсновнойВент.Value;

(* АВР: авария основного вентилятора -> вводим резервный *)
IF НастрЕстьВент2.Value AND NOT ДиагНетСвязи.Value THEN

    АвВент := FALSE;
    IF ОсновнойВент.Value = 1 THEN
        IF АвВент1.Value THEN АвВент := TRUE; END_IF;
    ELSE
        IF АвВент2.Value THEN АвВент := TRUE; END_IF;
    END_IF;

    IF АвВент THEN
        ОсновнойВент.Value := 3 - ОсновнойВент.Value;
        РезервныйВент.Value := 3 - ОсновнойВент.Value;
        АВРСработал.Value := TRUE;
    ELSIF NOT ТревогаПодтверждена.Value THEN
        АВРСработал.Value := FALSE;
    END_IF;
END_IF;

IF РучноеПереключение.Value AND НастрЕстьВент2.Value THEN
    ОсновнойВент.Value := 3 - ОсновнойВент.Value;
    РезервныйВент.Value := 3 - ОсновнойВент.Value;
    АВРСработал.Value := FALSE;
    РучноеПереключение.Value := FALSE;
END_IF;

РезервАктивен.Value         := FALSE;
ОбаВентилятораВРаботе.Value := FALSE;
НиОдинНеРаботает.Value      := FALSE;

IF НастрЕстьВент2.Value THEN
    IF РаботаВент1.Value AND РаботаВент2.Value THEN
        ОбаВентилятораВРаботе.Value := TRUE;
    ELSIF NOT РаботаВент1.Value AND NOT РаботаВент2.Value THEN
        НиОдинНеРаботает.Value := TRUE;
    ELSE
        IF ОсновнойВент.Value = 1 AND РаботаВент1.Value THEN
            РезервАктивен.Value := FALSE;
        ELSIF ОсновнойВент.Value = 2 AND РаботаВент2.Value THEN
            РезервАктивен.Value := FALSE;
        ELSE
            РезервАктивен.Value := TRUE;
        END_IF;
    END_IF;
ELSE
    IF NOT РаботаВент1.Value THEN
        НиОдинНеРаботает.Value := TRUE;
    END_IF;
END_IF;

IF ОбаВентилятораВРаботе.Value THEN
    РежимРаботыВент.Value := "Оба в работе";
ELSIF НиОдинНеРаботает.Value THEN
    РежимРаботыВент.Value := "Ни один не работает";
ELSIF РезервАктивен.Value THEN
    IF ОсновнойВент.Value = 1 THEN
        РежимРаботыВент.Value := "Основной В1, работает резервный В2";
    ELSE
        РежимРаботыВент.Value := "Основной В2, работает резервный В1";
    END_IF;
ELSE
    IF ОсновнойВент.Value = 1 THEN
        РежимРаботыВент.Value := "Основной В1";
    ELSE
        РежимРаботыВент.Value := "Основной В2";
    END_IF;
END_IF;

(* --- Команды вентиляторов ------------------------------------------------ *)

IF Включена.Value AND NOT Блокировка.Value AND NOT ДиагНетСвязи.Value THEN

    IF ОсновнойВент.Value = 1 THEN
        ПускВент1.Value := TRUE;
        СтопВент1.Value := FALSE;
        IF НастрЕстьВент2.Value THEN
            IF АВРСработал.Value THEN
                ПускВент2.Value := TRUE;
                СтопВент2.Value := FALSE;
            ELSE
                ПускВент2.Value := FALSE;
                СтопВент2.Value := TRUE;
            END_IF;
        END_IF;
    ELSE
        ПускВент2.Value := TRUE;
        СтопВент2.Value := FALSE;
        IF АВРСработал.Value THEN
            ПускВент1.Value := TRUE;
            СтопВент1.Value := FALSE;
        ELSE
            ПускВент1.Value := FALSE;
            СтопВент1.Value := TRUE;
        END_IF;
    END_IF;

ELSE
    ПускВент1.Value := FALSE;
    СтопВент1.Value := TRUE;
    IF НастрЕстьВент2.Value THEN
        ПускВент2.Value := FALSE;
        СтопВент2.Value := TRUE;
    END_IF;
END_IF;

IF ПускВент1.Value AND СтопВент1.Value THEN ПускВент1.Value := FALSE; END_IF;
IF ПускВент2.Value AND СтопВент2.Value THEN ПускВент2.Value := FALSE; END_IF;

(* Готовность вентиляторов *)
ГотовВент1.Value := NOT АвВент1.Value AND NOT ДиагНетСвязиВент1.Value AND NOT ДиагНетСвязи.Value;
IF НастрЕстьВент2.Value THEN
    ГотовВент2.Value := NOT АвВент2.Value AND NOT ДиагНетСвязиВент2.Value AND NOT ДиагНетСвязи.Value;
ELSE
    ГотовВент2.Value := FALSE;
END_IF;

(* --- Моточасы (для индикации распределения наработки) -------------------- *)

IF РаботаВент1.Value THEN
    ИнкМч1 := ШагПрограммыСек.Value / 3600.0;
    МчВент1Дроб.Value := МчВент1Дроб.Value + ИнкМч1;
    IF МчВент1Дроб.Value >= 1.0 THEN
        МчВент1.Value := МчВент1.Value + 1;
        МчВент1Дроб.Value := МчВент1Дроб.Value - 1.0;
    END_IF;
END_IF;

IF РаботаВент2.Value AND НастрЕстьВент2.Value THEN
    ИнкМч2 := ШагПрограммыСек.Value / 3600.0;
    МчВент2Дроб.Value := МчВент2Дроб.Value + ИнкМч2;
    IF МчВент2Дроб.Value >= 1.0 THEN
        МчВент2.Value := МчВент2.Value + 1;
        МчВент2Дроб.Value := МчВент2Дроб.Value - 1.0;
    END_IF;
END_IF;

(* ===========================================================================
   11. СЕЗОН, РАСХОД, СОСТОЯНИЕ
   =========================================================================== *)

IF НастрЕстьСезон.Value THEN
    IF ЗаданиеСезона.Value = 0 THEN
        ТекущийСезон.Value := "Зима";
    ELSIF ЗаданиеСезона.Value = 1 THEN
        ТекущийСезон.Value := "Лето";
    ELSIF ЛетнийРежим.Value THEN
        ТекущийСезон.Value := "Лето";
    ELSE
        ТекущийСезон.Value := "Зима";
    END_IF;
ELSE
    ТекущийСезон.Value := "Зима";
END_IF;

IF ОсновнойВент.Value = 1 THEN
    РасходВытяжки.Value := VФактВент1.Value * НомРасходаВытяжки.Value / 100.0;
ELSE
    РасходВытяжки.Value := VФактВент2.Value * НомРасходаВытяжки.Value / 100.0;
END_IF;

РаботаУстановки.Value := РаботаВент1.Value OR РаботаВент2.Value;

IF ЕстьАвария.Value OR ГрАварияГруппы.Value THEN
    СостояниеУст.Value := 3;
ELSIF ДиагНетСвязи.Value THEN
    СостояниеУст.Value := 4;
ELSIF ЕстьПредупр.Value THEN
    СостояниеУст.Value := 2;
ELSIF Включена.Value AND РаботаУстановки.Value THEN
    СостояниеУст.Value := 1;
ELSE
    СостояниеУст.Value := 0;
END_IF;

CASE СостояниеУст.Value OF
    0: СостояниеУстТекст.Value := "Стоп";
    1: СостояниеУстТекст.Value := "Работа";
    2: СостояниеУстТекст.Value := "Предупреждение";
    3: СостояниеУстТекст.Value := "Авария";
    4: СостояниеУстТекст.Value := "Нет данных";
ELSE
    СостояниеУстТекст.Value := "Нет данных";
END_CASE;

CASE ЗадРежима.Value OF
    0: ТекущийРежим.Value := "Авто";
    1: ТекущийРежим.Value := "Ручной";
    2: ТекущийРежим.Value := "Стоп";
ELSE
    ТекущийРежим.Value := "Нет данных";
END_CASE;

IF ДиагНетСвязи.Value THEN
    СостояниеСистемы.Value := "Нет данных";
ELSIF ЕстьАвария.Value THEN
    СостояниеСистемы.Value := "Авария";
ELSIF СостояниеУст.Value = 1 THEN
    СостояниеСистемы.Value := "Работа";
ELSE
    СостояниеСистемы.Value := "Остановлена";
END_IF;

(* Конец программы ПБЭ № 8 *)
