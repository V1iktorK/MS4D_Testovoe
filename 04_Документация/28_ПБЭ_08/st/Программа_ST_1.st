(* ============================================================================
   ПБЭ № 8. Универсальный ПБЭ вытяжной установки - Zentec M245, корпус 22.
   Программа: Программа_ST_1

   Экземпляры: 8 (В1 - В8)
     ШВ1: В1, ШВ2: В2, ШВ3: В3, ШВ4: В4, ШВ5: В5,
     отдельный шкаф В6, ОБЩИЙ ШКАФ ШВ7.8: В7 и В8.
   В7 и В8 - ОТДЕЛЬНЫЕ ЭКЗЕМПЛЯРЫ, несмотря на общий шкаф ШВ7.8.
   Индивидуальные сигналы и общие команды группы ОБОЗНАЧАЮТСЯ ОТДЕЛЬНО
   (ТЗ, приложение 1, часть 2, ПБЭ № 8).

   АВАРИИ A001 - A007 ПРИХОДЯТ ОТДЕЛЬНЫМИ ПРИЗНАКАМИ.
   Разбор битовых масок НЕ ВЫПОЛНЯЕТСЯ: масок DINT нет, GetBit не вызывается
   (ТЗ, п. 3). Текст аварии формируется ПО ПРИЗНАКУ.

   Реализованы требуемые механизмы:
     - аварии A001 - A007 отдельными признаками;
     - ПОЛОЖЕНИЯ КЛАПАНОВ (с признаком "в промежуточном положении");
     - команды СБРОСА АВАРИЙ и СБРОСА ЗУММЕРА;
     - применимые уставки и измерения;
     - задержки тревог;
     - групповые команды шкафа;
     - индикация основной и резервной работы.

   Состав узлов и функций выбирается настройками экземпляра; команды по
   отключённым функциям не формируются (ТЗ, п. 1.3).

   Планировщик - по ТЗ, п. 3.2. Команды формируются ТОЛЬКО через параметры
   экземпляра ПБЭ. Запись расписания во встроенные программы контроллеров
   НЕ ПРЕДУСМОТРЕНА.

   Ротация вентиляторов по наработке НЕ выполняется: ротация - требование
   ПБЭ № 2, а не ПБЭ № 8 (допущение D-80).
   ============================================================================ *)

VAR
    (* --- аварии --- *)
    КолA        : INT;    (* число активных кодов A001-A007 *)
    ПервыйКод   : INT;    (* номер первого активного кода 1..7, 0 если нет *)
    СыраяКрит   : BOOL;
    СыраяПред   : BOOL;

    (* --- задержки тревог --- *)
    СекТревоги  : INT;
    СекПредупр  : INT;
    СекОтпуск   : INT;
    ЗадержкаТревогиСек : INT;
    ЗадержкаПредупрСек : INT;
    ЗадержкаОтпускСек  : INT;
    ТаймерКрит  : INT;
    ТаймерПред  : INT;
    ТаймерОтпК  : INT;
    ТаймерОтпП  : INT;

    (* --- групповые команды --- *)
    ГруппаВкл   : BOOL;

    (* --- планировщик --- *)
    День   : STRING;   (* текущий день недели, принят из СистемаДеньНеделиТекст *)
    Час    : INT;      (* текущий час, принят из СистемаЧас *)
    Мин    : INT;      (* текущая минута, принята из СистемаМин *)
    ТекСек : INT;
    НачСек : INT;
    КонСек : INT;
    Акт1   : BOOL;
    Акт2   : BOOL;

    (* --- прочее --- *)
    АвВент  : BOOL;
    ИнкМч1  : REAL;
    ИнкМч2  : REAL;
END_VAR

(* ===========================================================================
   1. ОГРАНИЧЕНИЕ ВВОДИМЫХ УСТАВОК
   =========================================================================== *)

ЗадТВытяжки.Value    := LIMIT(MN := 5.0,  IN := ЗадТВытяжки.Value,    MX := 40.0);
УстТВытяжки.Value    := LIMIT(MN := 5.0,  IN := УстТВытяжки.Value,    MX := 40.0);
МинТВытяжки.Value    := LIMIT(MN := 0.0,  IN := МинТВытяжки.Value,    MX := 30.0);
ТПереходаЛето.Value  := LIMIT(MN := 0.0,  IN := ТПереходаЛето.Value,  MX := 30.0);
ТПереходаЗима.Value  := LIMIT(MN := -30.0, IN := ТПереходаЗима.Value, MX := 10.0);
СкоростьСниженияСтартВыдержки.Value := LIMIT(MN := 0.0, IN := СкоростьСниженияСтартВыдержки.Value, MX := 100.0);

IF ЗадVВытяжки.Value < 0 THEN
    ЗадVВытяжки.Value := 0;
ELSIF ЗадVВытяжки.Value > 100 THEN
    ЗадVВытяжки.Value := 100;
END_IF;

IF ЗадVПритока.Value < 0 THEN
    ЗадVПритока.Value := 0;
ELSIF ЗадVПритока.Value > 100 THEN
    ЗадVПритока.Value := 100;
END_IF;

IF ЗадДавления.Value < 0.0 THEN
    ЗадДавления.Value := 0.0;
ELSIF ЗадДавления.Value > 5000.0 THEN
    ЗадДавления.Value := 5000.0;
END_IF;

IF ВыборОсновногоВент.Value < 1 THEN
    ВыборОсновногоВент.Value := 1;
ELSIF ВыборОсновногоВент.Value > 3 THEN
    ВыборОсновногоВент.Value := 1;
END_IF;

IF ШагПрограммыСек.Value < 0.001 THEN
    ШагПрограммыСек.Value := 0.001;
ELSIF ШагПрограммыСек.Value > 3600.0 THEN
    ШагПрограммыСек.Value := 3600.0;
END_IF;

(* ===========================================================================
   2. ПРИМЕНИМОСТЬ: ОТКЛЮЧЁННЫЕ НАСТРОЙКОЙ УЗЛЫ И ФУНКЦИИ
      ТЗ, п. 1.3 и прил. 1 ч. 2: состав узлов и функций выбирается
      настройками экземпляра; команды по отключённым функциям
      не формируются.
   =========================================================================== *)

IF NOT НастрЕстьВент2.Value THEN
    ПускВент2.Value := FALSE;
    СтопВент2.Value := TRUE;
    РезервАктивен.Value := FALSE;
    ОбаВентилятораВРаботе.Value := FALSE;
    МчВент2.Value := 0;
    МчВент2Дроб.Value := 0.0;
    IF ВыборОсновногоВент.Value = 2 THEN
        ВыборОсновногоВент.Value := 1;
    END_IF;
END_IF;

IF NOT НастрЕстьКлапанПрит.Value THEN
    КлапанПритОткрыт.Value := FALSE;
    КлапанПритЗакрыт.Value := TRUE;
END_IF;

IF NOT НастрЕстьКлапанВыт.Value THEN
    КлапанВытОткрыт.Value := FALSE;
    КлапанВытЗакрыт.Value := TRUE;
END_IF;

IF NOT НастрФункцияСкорость.Value THEN
    ЗадVВытяжки.Value := 0;
    ЗадVПритока.Value := 0;
END_IF;

IF NOT НастрФункцияТемпература.Value THEN
    ЗадТВытяжки.Value := 0.0;
    УстТВытяжки.Value := 0.0;
END_IF;

IF NOT НастрФункцияДавление.Value THEN
    ЗадДавления.Value := 0.0;
END_IF;

(* Зуммер отключён настройкой - команда не формируется, кнопка скрыта *)
IF NOT НастрФункцияЗуммер.Value THEN
    СбросЗуммера.Value := FALSE;
    ЗуммерВключен.Value := FALSE;
    ЗуммерОтключенОператором.Value := FALSE;
END_IF;

IF NOT НастрФункцияЗадержки.Value THEN
    ЗадержкаТревоги.Value := 0;
    ЗадержкаПредупр.Value := 0;
    ЗадержкаОтпускания.Value := 0;
END_IF;

(* ===========================================================================
   3. ГРУППОВЫЕ КОМАНДЫ ОБЩЕГО ШКАФА
      Шесть установок имеют отдельные шкафы (ГрКолУстановок = 1).
      В7 и В8 работают от ОБЩЕГО шкафа ШВ7.8 (ГрКолУстановок = 2),
      но остаются ОТДЕЛЬНЫМИ экземплярами.
      Индивидуальные сигналы и общие команды группы обозначаются отдельно.
   =========================================================================== *)

ГруппаВкл := FALSE;

IF НастрФункцияГруппа.Value THEN

    IF ГрВклШкафа.Value AND NOT ГрСтопШкафа.Value THEN
        ГруппаВкл := TRUE;
        ГрКомандаПринята.Value := TRUE;
    ELSE
        ГрКомандаПринята.Value := FALSE;
    END_IF;

    IF ГрСбросАварий.Value THEN
        СбросАварии.Value := TRUE;
    END_IF;

    (* Групповой сброс зуммера по шкафу *)
    IF ГрСбросЗуммера.Value AND НастрФункцияЗуммер.Value THEN
        СбросЗуммера.Value := TRUE;
    END_IF;

    IF ГрАварийноеОтключение.Value THEN
        Включена.Value := FALSE;
        ГруппаВкл := FALSE;
    END_IF;

    IF ГрПереключениеРезерва.Value AND НастрЕстьВент2.Value THEN
        РучноеПереключение.Value := TRUE;
    END_IF;

ELSE
    ГрКомандаПринята.Value := FALSE;
END_IF;

(* ===========================================================================
   4. АВАРИИ A001 - A007 ОТДЕЛЬНЫМИ ПРИЗНАКАМИ
      ТЗ: "аварии A001-A007 отдельными признаками".
      Разбор битовых масок НЕ выполняется - масок нет (ТЗ, п. 3).
      Текст аварии формируется ПО ПРИЗНАКУ.
   =========================================================================== *)

КолA := 0;
ПервыйКод := 0;

IF АвA001.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 1; END_IF; END_IF;
IF АвA002.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 2; END_IF; END_IF;
IF АвA003.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 3; END_IF; END_IF;
IF АвA004.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 4; END_IF; END_IF;
IF АвA005.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 5; END_IF; END_IF;
IF АвA006.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 6; END_IF; END_IF;
IF АвA007.Value THEN КолA := КолA + 1; IF ПервыйКод = 0 THEN ПервыйКод := 7; END_IF; END_IF;

КолАварийA.Value := КолA;
ЕстьАварияA.Value := КолA > 0;

(* Текст первой активной аварии по коду производителя *)
CASE ПервыйКод OF
    1: АвA001Текст.Value := "A001";
       КодПервойАварии.Value := "A001";
    2: АвA001Текст.Value := "A002";
       КодПервойАварии.Value := "A002";
    3: АвA001Текст.Value := "A003";
       КодПервойАварии.Value := "A003";
    4: АвA001Текст.Value := "A004";
       КодПервойАварии.Value := "A004";
    5: АвA001Текст.Value := "A005";
       КодПервойАварии.Value := "A005";
    6: АвA001Текст.Value := "A006";
       КодПервойАварии.Value := "A006";
    7: АвA001Текст.Value := "A007";
       КодПервойАварии.Value := "A007";
ELSE
    АвA001Текст.Value := "";
    КодПервойАварии.Value := "";
END_CASE;

(* Перечень всех активных кодов одной строкой.
   ТЗ, п. 3: текст аварии формируется по признаку. *)
ТекстАварии.Value := "";

IF АвA001.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A001 "); END_IF;
IF АвA002.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A002 "); END_IF;
IF АвA003.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A003 "); END_IF;
IF АвA004.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A004 "); END_IF;
IF АвA005.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A005 "); END_IF;
IF АвA006.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A006 "); END_IF;
IF АвA007.Value THEN ТекстАварии.Value := CONCAT(IN1 := ТекстАварии.Value, IN2 := "A007 "); END_IF;

(* ===========================================================================
   5. ЗАДЕРЖКИ ТРЕВОГ
      Реализация - счётчик секунд (шаг = ШагПрограммыСек).
      Библиотечные TON и TOF здесь не используются: форма объявления
      экземпляра функционального блока в этой сборке не подтверждена
      (допущение D-62).
   =========================================================================== *)

ЗадержкаТревогиСек := TIME_TO_INT(IN := ЗадержкаТревоги.Value);
ЗадержкаПредупрСек := TIME_TO_INT(IN := ЗадержкаПредупр.Value);
ЗадержкаОтпускСек  := TIME_TO_INT(IN := ЗадержкаОтпускания.Value);

СекТревоги := ЗадержкаТревогиСек;
СекПредупр := ЗадержкаПредупрСек;
СекОтпуск  := ЗадержкаОтпускСек;

IF СекТревоги < 0 THEN СекТревоги := 0; END_IF;
IF СекПредупр < 0 THEN СекПредупр := 0; END_IF;
IF СекОтпуск  < 0 THEN СекОтпуск  := 0; END_IF;

(* --- 5.1. Сырые признаки ------------------------------------------------- *)

СыраяКрит := FALSE;
СыраяПред := FALSE;

(* Коды A001-A007 - критические *)
IF ЕстьАварияA.Value THEN СыраяКрит := TRUE; END_IF;

(* Прочие критические признаки *)
IF Пожар.Value        THEN СыраяКрит := TRUE; END_IF;
IF АвВент1.Value      THEN СыраяКрит := TRUE; END_IF;
IF АвВент2.Value AND НастрЕстьВент2.Value THEN СыраяКрит := TRUE; END_IF;
IF АвФильтр.Value     THEN СыраяКрит := TRUE; END_IF;
IF АвНагреватель.Value AND НастрЕстьНагреватель.Value THEN СыраяКрит := TRUE; END_IF;
IF АвОбщая.Value      THEN СыраяКрит := TRUE; END_IF;
IF ГрАвШкафа.Value    THEN СыраяКрит := TRUE; END_IF;
IF ГрАвПитанияШкафа.Value THEN СыраяКрит := TRUE; END_IF;

(* Признаки, зависящие от состава *)
IF НастрЕстьКлапанПрит.Value AND АвКлапанПрит.Value THEN СыраяКрит := TRUE; END_IF;
IF НастрЕстьКлапанВыт.Value  AND АвКлапанВыт.Value  THEN СыраяКрит := TRUE; END_IF;

(* Предупредительные *)
IF Предупреждение.Value          THEN СыраяПред := TRUE; END_IF;
IF Блокировка.Value              THEN СыраяПред := TRUE; END_IF;
IF АвДатчикТВытяжки.Value        THEN СыраяПред := TRUE; END_IF;
IF КлапанПритПромежут.Value      THEN СыраяПред := TRUE; END_IF;
IF КлапанВытПромежут.Value       THEN СыраяПред := TRUE; END_IF;

(* --- 5.2. Подтверждение критических признаков --------------------------- *)

IF СыраяКрит THEN

    IF СекТревоги = 0 THEN
        ТаймерКрит := 0;
        ТревогаПодтверждена.Value := TRUE;
    ELSE
        IF ТаймерКрит < СекТревоги THEN
            ТаймерКрит := ТаймерКрит + ШагПрограммыСек.Value;
            IF ТаймерКрит >= СекТревоги THEN
                ТаймерКрит := СекТревоги;
                ТревогаПодтверждена.Value := TRUE;
            ELSE
                ТревогаПодтверждена.Value := FALSE;
            END_IF;
        ELSE
            ТревогаПодтверждена.Value := TRUE;
        END_IF;
    END_IF;

ELSE
    ТаймерКрит := 0;

    IF СекОтпуск = 0 THEN
        ТревогаПодтверждена.Value := FALSE;
    ELSE
        IF ТревогаПодтверждена.Value THEN
            ТаймерОтпК := ТаймерОтпК + ШагПрограммыСек.Value;
            IF ТаймерОтпК >= СекОтпуск THEN
                ТаймерОтпК := 0;
                ТревогаПодтверждена.Value := FALSE;
            END_IF;
        ELSE
            ТаймерОтпК := 0;
        END_IF;
    END_IF;
END_IF;

(* --- 5.3. Подтверждение предупредительных признаков --------------------- *)

IF СыраяПред THEN

    IF СекПредупр = 0 THEN
        ТаймерПред := 0;
        ЕстьПредупр.Value := TRUE;
    ELSE
        IF ТаймерПред < СекПредупр THEN
            ТаймерПред := ТаймерПред + ШагПрограммыСек.Value;
            IF ТаймерПред >= СекПредупр THEN
                ТаймерПред := СекПредупр;
                ЕстьПредупр.Value := TRUE;
            ELSE
                ЕстьПредупр.Value := FALSE;
            END_IF;
        ELSE
            ЕстьПредупр.Value := TRUE;
        END_IF;
    END_IF;

ELSE
    ТаймерПред := 0;

    IF СекОтпуск = 0 THEN
        ЕстьПредупр.Value := FALSE;
    ELSE
        IF ЕстьПредупр.Value THEN
            ТаймерОтпП := ТаймерОтпП + ШагПрограммыСек.Value;
            IF ТаймерОтпП >= СекОтпуск THEN
                ТаймерОтпП := 0;
                ЕстьПредупр.Value := FALSE;
            END_IF;
        ELSE
            ТаймерОтпП := 0;
        END_IF;
    END_IF;
END_IF;

(* --- 5.4. Индикация таймеров -------------------------------------------- *)

ТаймерТревогиИдет.Value := СыраяКрит AND NOT ТревогаПодтверждена.Value;

IF ТаймерТревогиИдет.Value THEN
    ТаймерТревогиОсталось.Value := СекТревоги - ТаймерКрит;
    IF ТаймерТревогиОсталось.Value < 0 THEN
        ТаймерТревогиОсталось.Value := 0;
    END_IF;
ELSE
    ТаймерТревогиОсталось.Value := 0;
END_IF;

(* --- 5.5. Итоговые признаки аварии -------------------------------------- *)

КолАварий.Value := КолA;

IF ТревогаПодтверждена.Value THEN
    IF КолАварий.Value = 0 THEN
        КолАварий.Value := 1;
    END_IF;
END_IF;

ЕстьАвария.Value  := ТревогаПодтверждена.Value AND NOT ДиагНетСвязи.Value;
ОбщаяАвария.Value := ЕстьАвария.Value;
Авария.Value      := ЕстьАвария.Value;

(* Код аварии: -1 при отсутствии (по образцу, рис. А.2) *)
IF ЕстьАвария.Value THEN
    КодАварии.Value := 1;
ELSE
    КодАварии.Value := -1;
END_IF;

IF ЕстьПредупр.Value THEN
    КодПредупр.Value := 1;
ELSE
    КодПредупр.Value := -1;
END_IF;

ГрАварияГруппы.Value := ГрАварияШкафа.Value AND НастрФункцияГруппа.Value;

(* ===========================================================================
   6. ПОЛОЖЕНИЯ КЛАПАНОВ
      ТЗ: "положения клапанов".
      Определяются по концевым выключателям, а при их отсутствии -
      по аналоговому положению. Отдельно формируется признак
      "В ПРОМЕЖУТОЧНОМ ПОЛОЖЕНИИ": для клапана вентиляции застревание
      между положениями - самостоятельная неисправность.
   =========================================================================== *)

(* --- 6.1. Клапан притока ------------------------------------------------- *)

КлапанПритПромежут.Value := FALSE;

IF NOT НастрЕстьКлапанПрит.Value THEN
    КлапанПритТекст.Value := "Нет данных";
ELSIF КлапанПритОткрыт.Value THEN
    КлапанПритТекст.Value := "Открыт";
ELSIF КлапанПритЗакрыт.Value THEN
    КлапанПритТекст.Value := "Закрыт";
ELSIF (ПоложениеКлапанаПрит.Value > 5.0) AND (ПоложениеКлапанаПрит.Value < 95.0) THEN
    КлапанПритТекст.Value := "В промежуточном";
    КлапанПритПромежут.Value := TRUE;
ELSE
    КлапанПритТекст.Value := "Нет данных";
END_IF;

(* --- 6.2. Клапан вытяжки ------------------------------------------------- *)

КлапанВытПромежут.Value := FALSE;

IF NOT НастрЕстьКлапанВыт.Value THEN
    КлапанВытТекст.Value := "Нет данных";
ELSIF КлапанВытОткрыт.Value THEN
    КлапанВытТекст.Value := "Открыт";
ELSIF КлапанВытЗакрыт.Value THEN
    КлапанВытТекст.Value := "Закрыт";
ELSIF (ПоложениеКлапанаВыт.Value > 5.0) AND (ПоложениеКлапанаВыт.Value < 95.0) THEN
    КлапанВытТекст.Value := "В промежуточном";
    КлапанВытПромежут.Value := TRUE;
ELSE
    КлапанВытТекст.Value := "Нет данных";
END_IF;

