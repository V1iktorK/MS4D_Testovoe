(* ============================================================================
   ПБЭ № 1. Универсальный ПБЭ приточной установки -
   Carel pCO XS, Carel c.pCO, Carel µAria.
   Программа: Программа_ST_1

   Экземпляров: 18 (pCO XS: 8, c.pCO: 1, µAria: 9).

   ДВА ПУТИ ОБРАБОТКИ АВАРИЙ (ТЗ, п. 3 и приложение 1, часть 2):
     * pCO XS / c.pCO - аварии с РАЗБОРОМ БИТОВЫХ МАСОК.
       Маска хранится в DINT (АварияКрит1). Раскладка - из рисунка А.2.
     * µAria - аварии ОТДЕЛЬНЫМИ ЛОГИЧЕСКИМИ ПРИЗНАКАМИ,
       разбор масок НЕ ВЫПОЛНЯЕТСЯ.

   Планировщик - по ТЗ, п. 3.2. Команды формируются ТОЛЬКО через параметры
   экземпляра ПБЭ. Запись расписания во встроенные программы контроллеров
   НЕ ПРЕДУСМОТРЕНА.

   Влажность для варианта µAria НЕ ВЫВОДИТСЯ (ТЗ, приложение 1, часть 2):
   при ВариантОборудования = 3 программа принудительно гасит
   НастрЕстьВлажность и НастрРазборМаски.
   ============================================================================ *)

VAR
    (* --- рабочие переменные разбора маски (имена как в образце, рис. А.2) --- *)
    i : INT;
    n : INT;
    k : INT;

    (* --- рабочие переменные планировщика --- *)
    День   : STRING;   (* текущий день недели, принят из СистемаДеньНеделиТекст *)
    Час    : INT;      (* текущий час, принят из СистемаЧас *)
    Мин    : INT;      (* текущая минута, принята из СистемаМин *)
    ТекСек : INT;      (* текущее время суток в секундах от полуночи *)
    НачСек : INT;
    КонСек : INT;
    Акт1   : BOOL;
    Акт2   : BOOL;
    КритОтд: INT;      (* число отдельных (не из маски) критических аварий *)
    ПредупрОтд: BOOL;  (* есть предупредительный признак (не критический) *)
    Резерв : BOOL;     (* признак работы по резервному вентилятору *)
END_VAR

(* ===========================================================================
   0. ВЫБОР ВАРИАНТА ОБОРУДОВАНИЯ
      Настройки, обязательные для варианта, выставляются программой.
      ТЗ, приложение 1, часть 2: "Влажность для этого варианта не выводится";
      "аварии отдельными логическими признаками; разбор битовых масок
      не требуется".
   =========================================================================== *)

IF ВариантОборудования.Value = 3 THEN
    (* Carel µAria *)
    НастрЕстьВлажность.Value := FALSE;
    НастрРазборМаски.Value   := FALSE;
ELSE
    (* Carel pCO XS (1) и Carel c.pCO (2) *)
    IF НастрЕстьВлажность.Value THEN
        НастрРазборМаски.Value := TRUE;
    END_IF;
END_IF;

(* Увлажнитель без влажности не имеет смысла *)
IF NOT НастрЕстьВлажность.Value THEN
    НастрЕстьУвлажнитель.Value := FALSE;
END_IF;

(* ККБ (охлаждение) присутствует только при соответствующей настройке.
   Признак работы ККБ без блока принудительно снят. *)
IF NOT НастрЕстьККБ.Value THEN
    РаботаККБ.Value := FALSE;
END_IF;

(* ===========================================================================
   1. ОГРАНИЧЕНИЕ ВВОДИМЫХ УСТАВОК
   =========================================================================== *)

ЗадТПритока.Value         := LIMIT(MN := 5.0,  IN := ЗадТПритока.Value,         MX := 40.0);
УстТПритока.Value         := LIMIT(MN := 5.0,  IN := УстТПритока.Value,         MX := 40.0);
УстТПрогрева.Value        := LIMIT(MN := 5.0,  IN := УстТПрогрева.Value,        MX := 40.0);
УстТОбратнойВоды.Value    := LIMIT(MN := 5.0,  IN := УстТОбратнойВоды.Value,    MX := 70.0);
МинТПритока.Value         := LIMIT(MN := 0.0,  IN := МинТПритока.Value,         MX := 30.0);
ЗадВлажности.Value        := LIMIT(MN := 0.0,  IN := ЗадВлажности.Value,        MX := 100.0);
ЗимУровеньРециркуляции.Value := LIMIT(MN := 0.0, IN := ЗимУровеньРециркуляции.Value, MX := 100.0);
ТПереходаЛето.Value       := LIMIT(MN := 0.0,  IN := ТПереходаЛето.Value,       MX := 30.0);
ТПереходаЗима.Value       := LIMIT(MN := -30.0, IN := ТПереходаЗима.Value,      MX := 10.0);
СкоростьСниженияСтартВыдержки.Value := LIMIT(MN := 0.0, IN := СкоростьСниженияСтартВыдержки.Value, MX := 100.0);

IF ЗадVПритока.Value < 0 THEN
    ЗадVПритока.Value := 0;
ELSIF ЗадVПритока.Value > 100 THEN
    ЗадVПритока.Value := 100;
END_IF;

IF ЗадVВытяжки.Value < 0 THEN
    ЗадVВытяжки.Value := 0;
ELSIF ЗадVВытяжки.Value > 100 THEN
    ЗадVВытяжки.Value := 100;
END_IF;

IF ПериодПереключенияВент.Value < 1 THEN
    ПериодПереключенияВент.Value := 1;
ELSIF ПериодПереключенияВент.Value > 10000 THEN
    ПериодПереключенияВент.Value := 10000;
END_IF;

(* ===========================================================================
   2. РАЗБОР БИТОВЫХ МАСОК АВАРИЙ
      Выполняется ТОЛЬКО для pCO XS / c.pCO (НастрРазборМаски = TRUE).
      Раскладка и структура - дословно по рисунку А.2 Примера ПБЭ, вариант 4.
      Значения битов и переменных n, k - как в образце.
   =========================================================================== *)

(* Обнуление разобранных признаков - чтобы при выключенном разборе они не
   оставались в предыдущем состоянии *)
Пожар.Value              := FALSE;
АвЗаслВыт.Value          := FALSE;
АвЗаслПрит.Value         := FALSE;
АвПолохЗаслРецВыт.Value  := FALSE;
АвПолохЗаслРецПрит.Value := FALSE;
НизкаяТПомещения.Value   := FALSE;
ОбрывТПомещения.Value    := FALSE;

n := 0;
k := -1;

IF НастрРазборМаски.Value THEN

    (* Ограничение варианта разбора: значение 0 приводится к 1
       (как в образце: IF v = 0 THEN v := 1; END_IF;) *)
    IF ВариантАварий.Value = 0 THEN
        ВариантАварий.Value := 1;
    END_IF;

    (* -----------------------------------------------------------------------
       П7. Слово критических аварий одно, раскладка снята из копии AS06:
         0 пожар, 1 заслонка вытяжки, 2 заслонка притока,
         3 заслонка рециркуляции вытяжки, 4 заслонка рециркуляции притока,
         5 вентилятор притока, 6 вентилятор вытяжки,
         7 низкая температура помещения, 8 обрыв датчика температуры помещения.
         Аварии вентиляторов приходят и отдельными точками, их пишет канал.
       ----------------------------------------------------------------------- *)

    IF ВариантАварий.Value = 4 THEN

        Пожар.Value              := GetBit(IN := АварияКрит1.Value, N := 0);
        АвЗаслВыт.Value          := GetBit(IN := АварияКрит1.Value, N := 1);
        АвЗаслПрит.Value         := GetBit(IN := АварияКрит1.Value, N := 2);
        АвПолохЗаслРецВыт.Value  := GetBit(IN := АварияКрит1.Value, N := 3);
        АвПолохЗаслРецПрит.Value := GetBit(IN := АварияКрит1.Value, N := 4);
        ОбрывТПомещения.Value    := GetBit(IN := АварияКрит1.Value, N := 8);

        (* Бит 7 - низкая температура помещения. В образце он не разобран
           отдельным присваиванием, но разбор добавлен для полноты раскладки:
           значение бита 7 используется так же, как остальные. *)
        НизкаяТПомещения.Value   := GetBit(IN := АварияКрит1.Value, N := 7);

        (* Подсчёт числа установленных бит 0..8 и номера младшего бита.
           Биты 5 и 6 (вентиляторы) УЧИТЫВАЮТСЯ В ПОДСЧЁТЕ, но отдельных
           параметров для них не создаётся - по образцу рис. А.2:
           "Аварии вентиляторов приходят и отдельными точками". *)
        n := 0;
        k := -1;
        FOR i := 0 TO 8 DO
            IF GetBit(IN := АварияКрит1.Value, N := i) THEN
                n := n + 1;
                IF k < 0 THEN k := i; END_IF;
            END_IF;
        END_FOR;

    END_IF;
END_IF;

(* ===========================================================================
   3. ОТДЕЛЬНЫЕ ЛОГИЧЕСКИЕ ПРИЗНАКИ АВАРИЙ
      Основной путь для Carel µAria (разбор маски выключен).
      Для pCO XS / c.pCO - дополняет маску (биты 5, 6 и аварии узлов).
      Аварии отключённых настройкой узлов НЕ УЧИТЫВАЮТСЯ (ТЗ, п. 1.3).
   =========================================================================== *)

КритОтд := 0;

(* --- 3.1. Критические признаки, действующие всегда ---------------------- *)
IF АвВентПрит1.Value            THEN КритОтд := КритОтд + 1; END_IF;
IF АвВентВыт1.Value             THEN КритОтд := КритОтд + 1; END_IF;
IF АвПерепадПрит.Value          THEN КритОтд := КритОтд + 1; END_IF;
IF АвПерепадВыт.Value           THEN КритОтд := КритОтд + 1; END_IF;
IF АвФильтрПрит.Value           THEN КритОтд := КритОтд + 1; END_IF;
IF АвФильтрВыт.Value            THEN КритОтд := КритОтд + 1; END_IF;
IF АвНагреватель.Value          THEN КритОтд := КритОтд + 1; END_IF;
IF АвЗаслонкаПритНеОткр.Value   THEN КритОтд := КритОтд + 1; END_IF;
IF АвЗаслонкаВытНеОткр.Value    THEN КритОтд := КритОтд + 1; END_IF;
IF АвОшибкаПоложЗаслПрит.Value  THEN КритОтд := КритОтд + 1; END_IF;
IF АвОшибкаПоложЗаслВыт.Value   THEN КритОтд := КритОтд + 1; END_IF;

(* --- 3.2. Критические признаки, зависящие от состава оборудования -------- *)
IF НастрЕстьВентВыт2.Value   AND АвВентВыт2.Value   THEN КритОтд := КритОтд + 1; END_IF;
IF НастрЕстьККБ.Value        AND АвККБ.Value         THEN КритОтд := КритОтд + 1; END_IF;
IF НастрЕстьРекуператор.Value AND АвРекуператор.Value THEN КритОтд := КритОтд + 1; END_IF;
IF НастрЕстьНасос.Value      AND АвНасос.Value       THEN КритОтд := КритОтд + 1; END_IF;
IF НастрЕстьВлажность.Value  AND АвУвлажнитель.Value THEN КритОтд := КритОтд + 1; END_IF;

(* --- 3.3. Предупредительные признаки ------------------------------------
   По панели "Аварии" образца (рис. 1.1) это отдельная группа:
   термостаты, низкие температуры, датчики, "нет прогрева".
   Они формируют ЕстьПредупр, но НЕ входят в число критических аварий. *)
ПредупрОтд := FALSE;

IF АвТермостат1.Value     THEN ПредупрОтд := TRUE; END_IF;
IF АвТермостат2.Value     THEN ПредупрОтд := TRUE; END_IF;
IF АвНизкаяТВоды.Value    THEN ПредупрОтд := TRUE; END_IF;
IF АвНизкаяТПритока.Value THEN ПредупрОтд := TRUE; END_IF;
IF АвПрогревЗимой.Value   THEN ПредупрОтд := TRUE; END_IF;
IF АвДатчикТНарВозд.Value THEN ПредупрОтд := TRUE; END_IF;
IF АвДатчикТВоды.Value    THEN ПредупрОтд := TRUE; END_IF;
IF АвДатчикТПритока.Value THEN ПредупрОтд := TRUE; END_IF;

(* Общее число критических аварий = биты маски + отдельные признаки *)
КолАварий.Value := n + КритОтд;

ЕстьАвария.Value  := (КолАварий.Value > 0) AND NOT ДиагНетСвязи.Value;
ОбщаяАвария.Value := ЕстьАвария.Value;
Авария.Value      := ЕстьАвария.Value;

(* Код критической аварии:
   k >= 0  - номер младшего установленного бита маски (как в образце);
   k = -1  - критических бит в маске нет, но есть отдельные признаки. *)
IF КолАварий.Value = 0 THEN
    КодАварии.Value := -1;
ELSIF k >= 0 THEN
    КодАварии.Value := k;
ELSE
    КодАварии.Value := 100;
END_IF;

(* Предупреждения *)
ЕстьПредупр.Value := (Предупреждение.Value OR ПредупрОтд OR Блокировка.Value)
                     AND NOT ДиагНетСвязи.Value;

IF ЕстьПредупр.Value THEN
    КодПредупр.Value := 1;
ELSE
    КодПредупр.Value := -1;
END_IF;

(* ===========================================================================
   4. ПЛАНИРОВЩИК РАБОТЫ УСТАНОВКИ (ТЗ, п. 3.2)
      Недельное расписание, 7 дней x 2 интервала.
      Команды формируются ТОЛЬКО через параметры экземпляра ПБЭ.
   =========================================================================== *)

(* --- 4.1. Текущий день недели и время суток ------------------------------
   ВАЖНО: штатной функции получения текущего времени в проверенном перечне
   НЕТ (функция GET_LOCAL_TIME в среде отсутствует).
   Поэтому день недели и время суток принимаются ПАРАМЕТРАМИ от системы -
   так же, как все прочие входные величины ПБЭ (ТЗ, п. 3: элемент работает
   со своими параметрами, без подключения к конкретному контроллеру;
   к системному тегу времени их подключает ДИГАМ).
   ------------------------------------------------------------------------ *)

День := СистемаДеньНеделиТекст.Value;   (* "Пн" ... "Вс" *)
Час  := СистемаЧас.Value;               (* 0 ... 23 *)
Мин  := СистемаМин.Value;               (* 0 ... 59 *)

(* Ограничение принятых значений, чтобы неверный сигнал не сломал расписание *)
IF Час < 0 THEN
    Час := 0;
ELSIF Час > 23 THEN
    Час := 23;
END_IF;

IF Мин < 0 THEN
    Мин := 0;
ELSIF Мин > 59 THEN
    Мин := 59;
END_IF;

ТекСек := Час * 3600 + Мин * 60;

(* --- 4.2. Определение активного интервала текущего дня ------------------ *)

Акт1 := FALSE;
Акт2 := FALSE;

(* Понедельник *)
IF День = "Пн" THEN
    НачСек := ПланПн1НачалоЧ.Value * 3600 + ПланПн1НачалоМин.Value * 60;
    КонСек := ПланПн1КонецЧ.Value  * 3600 + ПланПн1КонецМин.Value  * 60;
    IF ПланПн1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланПн2Активация.Value THEN
        НачСек := ПланПн2НачалоЧ.Value * 3600 + ПланПн2НачалоМин.Value * 60;
        КонСек := ПланПн2КонецЧ.Value  * 3600 + ПланПн2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

(* Вторник *)
ELSIF День = "Вт" THEN
    НачСек := ПланВт1НачалоЧ.Value * 3600 + ПланВт1НачалоМин.Value * 60;
    КонСек := ПланВт1КонецЧ.Value  * 3600 + ПланВт1КонецМин.Value  * 60;
    IF ПланВт1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланВт2Активация.Value THEN
        НачСек := ПланВт2НачалоЧ.Value * 3600 + ПланВт2НачалоМин.Value * 60;
        КонСек := ПланВт2КонецЧ.Value  * 3600 + ПланВт2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

(* Среда *)
ELSIF День = "Ср" THEN
    НачСек := ПланСр1НачалоЧ.Value * 3600 + ПланСр1НачалоМин.Value * 60;
    КонСек := ПланСр1КонецЧ.Value  * 3600 + ПланСр1КонецМин.Value  * 60;
    IF ПланСр1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланСр2Активация.Value THEN
        НачСек := ПланСр2НачалоЧ.Value * 3600 + ПланСр2НачалоМин.Value * 60;
        КонСек := ПланСр2КонецЧ.Value  * 3600 + ПланСр2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

(* Четверг *)
ELSIF День = "Чт" THEN
    НачСек := ПланЧт1НачалоЧ.Value * 3600 + ПланЧт1НачалоМин.Value * 60;
    КонСек := ПланЧт1КонецЧ.Value  * 3600 + ПланЧт1КонецМин.Value  * 60;
    IF ПланЧт1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланЧт2Активация.Value THEN
        НачСек := ПланЧт2НачалоЧ.Value * 3600 + ПланЧт2НачалоМин.Value * 60;
        КонСек := ПланЧт2КонецЧ.Value  * 3600 + ПланЧт2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

(* Пятница *)
ELSIF День = "Пт" THEN
    НачСек := ПланПт1НачалоЧ.Value * 3600 + ПланПт1НачалоМин.Value * 60;
    КонСек := ПланПт1КонецЧ.Value  * 3600 + ПланПт1КонецМин.Value  * 60;
    IF ПланПт1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланПт2Активация.Value THEN
        НачСек := ПланПт2НачалоЧ.Value * 3600 + ПланПт2НачалоМин.Value * 60;
        КонСек := ПланПт2КонецЧ.Value  * 3600 + ПланПт2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

(* Суббота *)
ELSIF День = "Сб" THEN
    НачСек := ПланСб1НачалоЧ.Value * 3600 + ПланСб1НачалоМин.Value * 60;
    КонСек := ПланСб1КонецЧ.Value  * 3600 + ПланСб1КонецМин.Value  * 60;
    IF ПланСб1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланСб2Активация.Value THEN
        НачСек := ПланСб2НачалоЧ.Value * 3600 + ПланСб2НачалоМин.Value * 60;
        КонСек := ПланСб2КонецЧ.Value  * 3600 + ПланСб2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;

(* Воскресенье *)
ELSIF День = "Вс" THEN
    НачСек := ПланВс1НачалоЧ.Value * 3600 + ПланВс1НачалоМин.Value * 60;
    КонСек := ПланВс1КонецЧ.Value  * 3600 + ПланВс1КонецМин.Value  * 60;
    IF ПланВс1Активация.Value THEN
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт1 := TRUE; END_IF;
        END_IF;
    END_IF;
    IF НастрПланИнтервал2.Value AND ПланВс2Активация.Value THEN
        НачСек := ПланВс2НачалоЧ.Value * 3600 + ПланВс2НачалоМин.Value * 60;
        КонСек := ПланВс2КонецЧ.Value  * 3600 + ПланВс2КонецМин.Value  * 60;
        IF НачСек <= КонСек THEN
            IF (ТекСек >= НачСек) AND (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        ELSE
            IF (ТекСек >= НачСек) OR (ТекСек < КонСек) THEN Акт2 := TRUE; END_IF;
        END_IF;
    END_IF;
END_IF;

(* --- 4.3. Приоритет интервала 2 и формирование выхода ------------------- *)

ПланВключить.Value  := FALSE;
ПланОтключить.Value := FALSE;
ПланЗадT.Value      := 0.0;
ПланЗадV.Value      := 0;
ПланЗадРежим.Value  := 0;

IF Акт2 THEN
    ТекущийИнтервал.Value := 2;
ELSIF Акт1 THEN
    ТекущийИнтервал.Value := 1;
ELSE
    ТекущийИнтервал.Value := -1;
END_IF;

(* Сколько интервалов сетки накрывают текущий момент (0, 1 или 2).
   Считается по сетке расписания независимо от ПланРасписаниеАктивно -
   это диагностический параметр для окна и трендов. *)
ПланАктивныхИнтервалов.Value := 0;
IF Акт1 THEN
    ПланАктивныхИнтервалов.Value := ПланАктивныхИнтервалов.Value + 1;
END_IF;
IF Акт2 THEN
    ПланАктивныхИнтервалов.Value := ПланАктивныхИнтервалов.Value + 1;
END_IF;

IF ПланРасписаниеАктивно.Value THEN

    IF ТекущийИнтервал.Value = 2 THEN
        ПланВключить.Value := TRUE;
        IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланПн2УставкаT.Value; END_IF;
        IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланПн2УставкаV.Value; END_IF;
        IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланПн2РежимРаботы.Value; END_IF;

    ELSIF ТекущийИнтервал.Value = 1 THEN
        ПланВключить.Value := TRUE;

    ELSE
        (* Активного интервала нет - расписание отключает установку *)
        ПланОтключить.Value := TRUE;
    END_IF;

    (* Уставки активного интервала 1 берутся по текущему дню.
       Интервал 2 уже обработан выше: чтобы не дублировать разбор дня,
       уставки интервала 1 выбираются отдельным блоком ниже. *)
    IF ТекущийИнтервал.Value = 1 THEN
        IF День = "Пн" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланПн1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланПн1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланПн1РежимРаботы.Value; END_IF;
        ELSIF День = "Вт" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланВт1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланВт1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланВт1РежимРаботы.Value; END_IF;
        ELSIF День = "Ср" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланСр1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланСр1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланСр1РежимРаботы.Value; END_IF;
        ELSIF День = "Чт" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланЧт1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланЧт1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланЧт1РежимРаботы.Value; END_IF;
        ELSIF День = "Пт" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланПт1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланПт1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланПт1РежимРаботы.Value; END_IF;
        ELSIF День = "Сб" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланСб1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланСб1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланСб1РежимРаботы.Value; END_IF;
        ELSIF День = "Вс" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланВс1УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланВс1УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланВс1РежимРаботы.Value; END_IF;
        END_IF;
    END_IF;

    (* Уставки интервала 2 - по текущему дню *)
    IF ТекущийИнтервал.Value = 2 THEN
        IF День = "Вт" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланВт2УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланВт2УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланВт2РежимРаботы.Value; END_IF;
        ELSIF День = "Ср" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланСр2УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланСр2УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланСр2РежимРаботы.Value; END_IF;
        ELSIF День = "Чт" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланЧт2УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланЧт2УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланЧт2РежимРаботы.Value; END_IF;
        ELSIF День = "Пт" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланПт2УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланПт2УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланПт2РежимРаботы.Value; END_IF;
        ELSIF День = "Сб" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланСб2УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланСб2УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланСб2РежимРаботы.Value; END_IF;
        ELSIF День = "Вс" THEN
            IF НастрПланЗадT.Value THEN ПланЗадT.Value := ПланВс2УставкаT.Value; END_IF;
            IF НастрПланЗадV.Value THEN ПланЗадV.Value := ПланВс2УставкаV.Value; END_IF;
            IF НастрПланРежим.Value THEN ПланЗадРежим.Value := ПланВс2РежимРаботы.Value; END_IF;
        END_IF;
    END_IF;

END_IF;

(* --- 4.4. Применение команд планировщика к параметрам ПБЭ ----------------
   ТЗ, п. 3.2: SCADA формирует команды ЧЕРЕЗ ПАРАМЕТРЫ ЭКЗЕМПЛЯРА ПБЭ.
   Запись расписания во встроенные программы контроллеров НЕ производится:
   планировщик воздействует только на параметры элемента, а к тегам
   установки их подключает ДИАГАМ (ТЗ, п. 3).
   ------------------------------------------------------------------------ *)

КомандаПоРасписанию.Value := FALSE;

IF ПланРасписаниеАктивно.Value
   AND (ЗадРежима.Value <> 1)          (* не ручной режим - оператор главнее *)
   AND NOT Блокировка.Value
   AND NOT ДиагНетСвязи.Value THEN

    IF ПланВключить.Value THEN
        Включена.Value              := TRUE;
        КомандаПоРасписанию.Value   := TRUE;
    END_IF;

    IF ПланОтключить.Value THEN
        Включена.Value              := FALSE;
        КомандаПоРасписанию.Value   := TRUE;
    END_IF;

    IF НастрПланЗадT.Value AND ПланВключить.Value THEN
        ЗадТПритока.Value := ПланЗадT.Value;
    END_IF;

    IF НастрПланЗадV.Value AND ПланВключить.Value THEN
        ЗадVПритока.Value := ПланЗадV.Value;
    END_IF;

    IF НастрПланРежим.Value AND ПланВключить.Value THEN
        ЗадРежима.Value := ПланЗадРежим.Value;
    END_IF;
END_IF;

(* ===========================================================================
   5. УПРАВЛЕНИЕ, АВР, КОМАНДЫ
   =========================================================================== *)

Отключена.Value := NOT Включена.Value;

(* Взаимоисключение пуск/стоп: приоритет у "Стоп" *)
IF ПускВентПрит1.Value AND СтопВентПрит1.Value THEN ПускВентПрит1.Value := FALSE; END_IF;
IF ПускВентВыт1.Value  AND СтопВентВыт1.Value  THEN ПускВентВыт1.Value  := FALSE; END_IF;
IF ПускНасоса.Value    AND СтопНасоса.Value    THEN ПускНасоса.Value    := FALSE; END_IF;

(* Команды отключённых настройкой узлов не формируются (ТЗ, п. 1.3) *)
IF NOT НастрЕстьНасос.Value THEN
    ПускНасоса.Value := FALSE;
    СтопНасоса.Value := TRUE;
END_IF;

IF NOT НастрЕстьВентВыт1.Value THEN
    ПускВентВыт1.Value := FALSE;
    СтопВентВыт1.Value := TRUE;
END_IF;

(* Признак работы вытяжного вентилятора 2 читается только при наличии узла.
   Команда по отключённому узлу не формируется (ТЗ, п. 1.3). *)
IF NOT НастрЕстьВентВыт2.Value THEN
    РаботаВентВыт2.Value := FALSE;
END_IF;

(* --- АВР: выбор основного вентилятора ---------------------------------- *)

IF НастрЕстьАВР.Value THEN

    IF ОсновнойВентПрит.Value <> 1 AND ОсновнойВентПрит.Value <> 2 THEN
        ОсновнойВентПрит.Value := 1;
    END_IF;
    IF ОсновнойВентВыт.Value <> 1 AND ОсновнойВентВыт.Value <> 2 THEN
        ОсновнойВентВыт.Value := 1;
    END_IF;

    (* Жёсткий выбор основного вентилятора приточного *)
    IF ВыборОсновногоВентПрит.Value = 1 THEN
        ОсновнойВентПрит.Value := 1;
    ELSIF ВыборОсновногоВентПрит.Value = 2 THEN
        ОсновнойВентПрит.Value := 2;
    END_IF;

    (* Жёсткий выбор основного вентилятора вытяжного *)
    IF ВыборОсновногоВентВыт.Value = 1 THEN
        ОсновнойВентВыт.Value := 1;
    ELSIF ВыборОсновногоВентВыт.Value = 2 THEN
        ОсновнойВентВыт.Value := 2;
    END_IF;

    (* Срабатывание АВР: авария основного приточного вентилятора *)
    Резерв := FALSE;
    IF ОсновнойВентПрит.Value = 1 THEN
        IF АвВентПрит1.Value AND NOT ДиагНетСвязи.Value THEN Резерв := TRUE; END_IF;
    ELSE
        IF АвВентПрит2.Value AND NOT ДиагНетСвязи.Value THEN Резерв := TRUE; END_IF;
    END_IF;

    IF Резерв THEN
        ОсновнойВентПрит.Value := 3 - ОсновнойВентПрит.Value;
        АВРСработал.Value      := TRUE;
    ELSIF NOT ЕстьАвария.Value THEN
        АВРСработал.Value := FALSE;
    END_IF;

    (* Команды по основному вентилятору приточного *)
    IF Включена.Value AND NOT Блокировка.Value AND NOT ДиагНетСвязи.Value THEN
        IF ОсновнойВентПрит.Value = 1 THEN
            ПускВентПрит1.Value := TRUE;
            СтопВентПрит1.Value := FALSE;
        ELSE
            ПускВентПрит1.Value := FALSE;
            СтопВентПрит1.Value := TRUE;
        END_IF;
    ELSE
        ПускВентПрит1.Value := FALSE;
        СтопВентПрит1.Value := TRUE;
    END_IF;

ELSE
    (* АВР не предусмотрен - работает приточный вентилятор 1 *)
    ОсновнойВентПрит.Value := 1;
    АВРСработал.Value      := FALSE;

    IF Включена.Value AND NOT Блокировка.Value AND NOT ДиагНетСвязи.Value THEN
        ПускВентПрит1.Value := TRUE;
        СтопВентПрит1.Value := FALSE;
    ELSE
        ПускВентПрит1.Value := FALSE;
        СтопВентПрит1.Value := TRUE;
    END_IF;
END_IF;

(* Команды вытяжного вентилятора - «ведомый» по приточному *)
IF Включена.Value AND NOT Блокировка.Value AND NOT ДиагНетСвязи.Value THEN
    ПускВентВыт1.Value := НастрЕстьВентВыт1.Value;
    СтопВентВыт1.Value := NOT НастрЕстьВентВыт1.Value;
ELSE
    ПускВентВыт1.Value := FALSE;
    СтопВентВыт1.Value := TRUE;
END_IF;

(* Насос - только при наличии и при работе установки *)
IF НастрЕстьНасос.Value AND Включена.Value AND NOT ДиагНетСвязи.Value THEN
    ПускНасоса.Value := TRUE;
    СтопНасоса.Value := FALSE;
END_IF;

(* Сброс команды сброса аварий *)
IF СбросАварии.Value THEN
    СбросАварии.Value := FALSE;
END_IF;

(* Сезон *)
IF НастрЕстьСезон.Value THEN
    IF ЗаданиеСезона.Value = 0 THEN
        ТекущийСезон.Value := "Зима";
    ELSIF ЗаданиеСезона.Value = 1 THEN
        ТекущийСезон.Value := "Лето";
    ELSIF ЛетнийРежим.Value THEN
        ТекущийСезон.Value := "Лето";
    ELSE
        ТекущийСезон.Value := "Зима";
    END_IF;
ELSE
    ТекущийСезон.Value := "Зима";
END_IF;

(* Задание нагрев/охлаждение для варианта µAria *)
IF ВариантОборудования.Value = 3 THEN
    IF ЗадНагревОхлаждение.Value < 0 THEN
        ЗадНагревОхлаждение.Value := 0;
    ELSIF ЗадНагревОхлаждение.Value > 2 THEN
        ЗадНагревОхлаждение.Value := 2;
    END_IF;
    IF NOT НастрЕстьККБ.Value THEN
        (* Без ККБ охлаждение невозможно *)
        IF ЗадНагревОхлаждение.Value = 1 THEN
            ЗадНагревОхлаждение.Value := 0;
        END_IF;
    END_IF;
END_IF;

(* ===========================================================================
   6. СОСТОЯНИЯ УЗЛОВ ТЕКСТОМ
   =========================================================================== *)

IF ЗаслонкаПритОткрыта.Value THEN
    ЗаслонкаПритТекст.Value := "Открыта";
ELSIF ЗаслонкаПритЗакрыта.Value THEN
    ЗаслонкаПритТекст.Value := "Закрыта";
ELSE
    ЗаслонкаПритТекст.Value := "Нет данных";
END_IF;

IF ЗаслонкаВытОткрыта.Value THEN
    ЗаслонкаВытТекст.Value := "Открыта";
ELSIF ЗаслонкаВытЗакрыта.Value THEN
    ЗаслонкаВытТекст.Value := "Закрыта";
ELSE
    ЗаслонкаВытТекст.Value := "Нет данных";
END_IF;

(* ===========================================================================
   7. РАСХОД
   =========================================================================== *)

РасходПритока.Value := VФактПритока.Value * НомРасходаПритока.Value / 100.0;
РасходВытяжки.Value := VФактВытяжки.Value * НомРасходаВытяжки.Value / 100.0;

(* ===========================================================================
   8. СОСТОЯНИЕ УСТАНОВКИ
      Приоритет: Авария > Нет связи > Предупреждение > Работа > Стоп
   =========================================================================== *)

РаботаУстановки.Value := РаботаВентПрит1.Value OR РаботаВентПрит2.Value;

IF ЕстьАвария.Value THEN
    СостояниеУст.Value := 3;
ELSIF ДиагНетСвязи.Value THEN
    СостояниеУст.Value := 4;
ELSIF ЕстьПредупр.Value THEN
    СостояниеУст.Value := 2;
ELSIF Включена.Value AND РаботаУстановки.Value THEN
    СостояниеУст.Value := 1;
ELSE
    СостояниеУст.Value := 0;
END_IF;

CASE СостояниеУст.Value OF
    0: СостояниеУстТекст.Value := "Стоп";
    1: СостояниеУстТекст.Value := "Работа";
    2: СостояниеУстТекст.Value := "Предупреждение";
    3: СостояниеУстТекст.Value := "Авария";
    4: СостояниеУстТекст.Value := "Нет данных";
ELSE
    СостояниеУстТекст.Value := "Нет данных";
END_CASE;

CASE ЗадРежима.Value OF
    0: ТекущийРежим.Value := "Авто";
    1: ТекущийРежим.Value := "Ручной";
    2: ТекущийРежим.Value := "Стоп";
ELSE
    ТекущийРежим.Value := "Нет данных";
END_CASE;

IF ДиагНетСвязи.Value THEN
    СостояниеСистемы.Value := "Нет данных";
ELSIF ЕстьАвария.Value THEN
    СостояниеСистемы.Value := "Авария";
ELSIF СостояниеУст.Value = 1 THEN
    СостояниеСистемы.Value := "Работа";
ELSE
    СостояниеСистемы.Value := "Остановлена";
END_IF;

(* КомандаПоРасписанию удерживается в TRUE на весь активный интервал *)
IF ПланРасписаниеАктивно.Value AND (ТекущийИнтервал.Value > 0) THEN
    КомандаПоРасписанию.Value := TRUE;
END_IF;

(* Конец программы ПБЭ № 1 *)
