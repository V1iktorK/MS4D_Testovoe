ОбщаяАвария.Value := ЕстьАвария.Value;

(* Предупреждение: аварий нет, но связь потеряна, либо есть отклонение *)
ЕстьПредупр.Value := (NOT ЕстьАвария.Value) AND ДиагНетСвязи.Value;

IF КолАв = 0 THEN
    КодАварии.Value := -1;
    КодАварииТекст.Value := "";
ELSIF ПервыйАв = 1 THEN
    КодАварии.Value := 1;
    КодАварииТекст.Value := Вн01Обозначение.Value;
ELSIF ПервыйАв = 2 THEN
    КодАварии.Value := 2;
    КодАварииТекст.Value := Вн02Обозначение.Value;
ELSIF ПервыйАв = 3 THEN
    КодАварии.Value := 3;
    КодАварииТекст.Value := Вн03Обозначение.Value;
ELSIF ПервыйАв = 4 THEN
    КодАварии.Value := 4;
    КодАварииТекст.Value := Вн04Обозначение.Value;
ELSIF ПервыйАв = 5 THEN
    КодАварии.Value := 5;
    КодАварииТекст.Value := Вн05Обозначение.Value;
ELSIF ПервыйАв = 6 THEN
    КодАварии.Value := 6;
    КодАварииТекст.Value := Вн06Обозначение.Value;
ELSIF ПервыйАв = 7 THEN
    КодАварии.Value := 7;
    КодАварииТекст.Value := Вн07Обозначение.Value;
ELSIF ПервыйАв = 8 THEN
    КодАварии.Value := 8;
    КодАварииТекст.Value := Вн08Обозначение.Value;
ELSIF ПервыйАв = 9 THEN
    КодАварии.Value := 9;
    КодАварииТекст.Value := Вн09Обозначение.Value;
ELSIF ПервыйАв = 10 THEN
    КодАварии.Value := 10;
    КодАварииТекст.Value := Вн10Обозначение.Value;
ELSE
    КодАварии.Value := 100;
    КодАварииТекст.Value := "Блок с индексом > 10";
END_IF;

IF ДиагНетСвязи.Value THEN
    СостояниеСистемы.Value := 4;
ELSIF ЕстьАвария.Value THEN
    СостояниеСистемы.Value := 3;
ELSIF ЕстьПредупр.Value THEN
    СостояниеСистемы.Value := 2;
ELSIF КолВкл > 0 THEN
    СостояниеСистемы.Value := 1;
ELSE
    СостояниеСистемы.Value := 0;
END_IF;

CASE СостояниеСистемы.Value OF
    0: СостояниеСистемыТекст.Value := "Стоп";
    1: СостояниеСистемыТекст.Value := "Работа";
    2: СостояниеСистемыТекст.Value := "Предупреждение";
    3: СостояниеСистемыТекст.Value := "Авария";
    4: СостояниеСистемыТекст.Value := "Нет данных";
ELSE
    СостояниеСистемыТекст.Value := "Нет данных";
END_CASE;

(* Преобладающий режим системы *)
РежимОхл := 0;
РежимНагр := 0;

IF Вн01Включение.Value AND Вн01Режим.Value = 1 THEN РежимОхл := РежимОхл + 1; END_IF;
IF Вн01Включение.Value AND Вн01Режим.Value = 2 THEN РежимНагр := РежимНагр + 1; END_IF;

IF РежимОхл > 0 AND РежимНагр > 0 THEN
    ТекущийРежимСистемы.Value := "Смешанный";
ELSIF РежимОхл > 0 THEN
    ТекущийРежимСистемы.Value := "Охлаждение";
ELSIF РежимНагр > 0 THEN
    ТекущийРежимСистемы.Value := "Нагрев";
ELSE
    ТекущийРежимСистемы.Value := "Нет активных блоков";
END_IF;

(* Конец программы ПБЭ № 5 *)
