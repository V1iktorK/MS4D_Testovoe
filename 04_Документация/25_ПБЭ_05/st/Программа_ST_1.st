(* Режим: 0 Авто, 1 Охлаждение, 2 Нагрев, 3 Вентиляция, 4 Осушение
   Код для шлюза формируется ниже. *)
Вн01РежимКанал.Value := Вн01Режим.Value;
Вн01ВентиляторКанал.Value := Вн01Вентилятор.Value;

(* Для производителя 1 (LG) коды универсальные совпадают с кодами шлюза.
   Для производителя 2 (Electrolux) и 3 (MDV) таблицу уточнить по описанию
   параметров и команд от ДИГАМ - правится ТОЛЬКО этот блок. *)
IF Производитель.Value = 1 THEN
    Вн01РежимКанал.Value := Вн01Режим.Value;
    Вн01ВентиляторКанал.Value := Вн01Вентилятор.Value;
ELSIF Производитель.Value = 2 THEN
    Вн01РежимКанал.Value := Вн01Режим.Value;
    Вн01ВентиляторКанал.Value := Вн01Вентилятор.Value;
ELSE
    Вн01РежимКанал.Value := Вн01Режим.Value;
    Вн01ВентиляторКанал.Value := Вн01Вентилятор.Value;
END_IF;

